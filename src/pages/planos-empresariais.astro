---
import Layout from '../layouts/Layout.astro';
import Banner from '../components/BannerEmpresarial.astro';
import Empresarial from '../components/Empresarial.astro';
import FaleConosco from '../components/Fale-conosco.astro';
---

<Layout title="Empresarial">

    <Banner />

    <Empresarial />

    <FaleConosco />

</Layout>

<script is:inline>
  (function () {
    var tentativas = 0;
    var timer = setInterval(function () {
      var el = document.getElementById('empresas-confiam');
      if (el) {
        el.scrollIntoView({ block: 'start', behavior: 'auto' });
      }
      if (++tentativas >= 5) clearInterval(timer);
    }, 200);
  })();
</script>