---
import Layout from '../layouts/Layout.astro';

interface Aditivo {
    nome: string;
    link: string;
}

interface Contrato {
    titulo: string;
    descricao: string;
    link: string;
    icone: string;
    cor: string;
    aditivos: Aditivo[];
}

const contratos: Contrato[] = [
    {
        titulo: 'Contrato SCM',
        descricao: 'Serviço de Conectividade Multiprotocolo com Segurança',
        link: '/contratos/SCM/SCM.pdf',
        icone: '📋',
        cor: 'from-cyan-500 to-blue-600',
        aditivos: [
          { nome: 'Termo Aditivo SCM 1', link: '/contratos/SCM/Termo-Aditivo-SCM-1.docx' },
          { nome: 'Termo Aditivo SCM 2', link: '/contratos/SCM/Termo-Aditivo-SCM-2.docx' },
          { nome: 'Termo Aditivo SCM 3', link: '/contratos/SCM/Termo-Aditivo-SCM-3.pdf' }
        ]
    },
    {
        titulo: 'Contrato de SVA',
        descricao: 'Serviços de Valor Agregado para sua conexão de internet',
        link: '/contratos/SVA/SVA.pdf',
        icone: '⚙️',
        cor: 'from-purple-500 to-pink-600',
        aditivos: [
          { nome: 'Termo Aditivo SVA 1', link: '/contratos/SVA/Termo-Aditivo-SVA-1.docx' },
          { nome: 'Termo Aditivo SVA 2', link: '/contratos/SVA/Termo-Aditivo-SVA-2.pdf' }
        ]
    },
    {
        titulo: 'Contrato Seitel CAM',
        descricao: 'Contrato de Acesso e Monitoramento de Câmeras Inteligentes',
        link: '/contratos/SEITEL-CAM/SEITEL-CAM-novo.pdf',
        icone: '📹',
        cor: 'from-orange-500 to-red-600',
        aditivos: [
            { nome: 'Termo Seitel Cam 2024', link: '/contratos/SEITEL-CAM/Termo-Seitel-Cam-2024.pdf' },
            { nome: 'Seitel CAM Novo 1', link: '/contratos/SEITEL-CAM/SEITEL-CAM-novo-1.pdf' }
        ]
    }
];
---

<Layout title="Seitel - Contratos">

<!-- Hero Section -->
<div class="relative h-screen md:h-96 bg-gradient-to-br from-gray-900 via-black to-gray-900 overflow-hidden">
    <!-- Background effect -->
    <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 via-purple-500/10 to-pink-500/10 blur-3xl"></div>
    
    <!-- Content -->
    <div class="relative z-10 h-full flex flex-col items-center justify-center px-6 md:px-12">
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-4 text-center">
            Nossos
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
                Contratos
            </span>
        </h1>
        <p class="text-gray-400 text-lg md:text-xl text-center max-w-2xl">
            Acesse e faça download de todos os contratos da Seitel de forma segura e organizada
        </p>
    </div>
</div>

<!-- Contratos Grid -->
<section class="py-20 px-6 md:px-12 bg-gradient-to-br from-gray-900 via-black to-gray-900 relative">
    <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/5 via-transparent to-pink-500/5 blur-3xl"></div>
    
    <div class="container mx-auto relative z-10 max-w-6xl">
        <!-- Grid de Contratos -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {contratos.map((contrato, index) => (
                <div 
                    class="group relative h-full"
                    style={`animation-delay: ${index * 100}ms`}
                >
                    <!-- Card Background Gradient -->
                    <div class={`absolute -inset-1 rounded-2xl blur opacity-25 group-hover:opacity-75 transition duration-500 bg-gradient-to-r ${contrato.cor}`}></div>
                    
                    <!-- Card Content -->
                    <div class="relative bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm rounded-2xl p-8 h-full flex flex-col justify-between border border-white/10 hover:border-white/30 transition duration-300">
                        
                        <!-- Icone e Titulo -->
                        <div>
                            <div class={`inline-flex items-center justify-center w-16 h-16 rounded-xl bg-gradient-to-br ${contrato.cor} mb-6 text-3xl`}>
                                {contrato.icone}
                            </div>
                            
                            <h3 class="text-2xl font-bold text-white mb-3">
                                {contrato.titulo}
                            </h3>
                            
                            <p class="text-gray-400 text-sm leading-relaxed">
                                {contrato.descricao}
                            </p>
                        </div>
                        
                        <!-- Download Button -->
                        <a 
                            href={contrato.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class={`mt-8 inline-flex items-center justify-center gap-2 w-full px-6 py-3 rounded-xl font-bold text-white transition-all duration-300 bg-gradient-to-r ${contrato.cor} hover:shadow-lg hover:scale-105 group/btn`}
                        >
                            <svg class="w-5 h-5 transition-transform group-hover/btn:translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                            </svg>
                            Baixar Contrato
                        </a>
                        
                        <!-- Metadata -->
                        <div class="mt-6 pt-6 border-t border-white/10">
                            <p class="text-xs text-gray-500 flex items-center gap-2 mb-4">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                </svg>
                                Arquivo PDF
                            </p>
                            
                            {/* Aditivos */}
                            {contrato.aditivos && contrato.aditivos.length > 0 && (
                                <div class="mt-4 pt-4 border-t border-white/10">
                                    <p class="text-xs font-semibold text-gray-300 mb-3 flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m0 0h6"></path>
                                        </svg>
                                        Aditivos ({contrato.aditivos.length})
                                    </p>
                                    <ul class="space-y-2">
                                        {contrato.aditivos.map((aditivo) => (
                                            <li>
                                                <a 
                                                    href={aditivo.link}
                                                    target="_blank"
                                                    rel="noopener noreferrer"
                                                    class="inline-flex items-center gap-2 text-xs text-cyan-400 hover:text-cyan-300 transition-colors duration-200 group/link"
                                                >
                                                    <svg class="w-3 h-3 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                                                    </svg>
                                                    {aditivo.nome}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Info Section -->
<section class="py-16 px-6 md:px-12 bg-gray-950 border-t border-white/10">
    <div class="container mx-auto max-w-4xl">
        <div class="bg-gradient-to-br from-cyan-500/10 to-blue-600/10 border border-cyan-500/30 rounded-2xl p-8 text-center">
            <h3 class="text-xl font-bold text-white mb-2">Dúvidas sobre nossos contratos?</h3>
            <p class="text-gray-400 mb-6">Entre em contato conosco para maiores informações sobre termos e condições</p>
            <a 
                href="https://wa.me/555136531254?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20os%20contratos%20da%20Seitel"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-8 py-3 bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300"
            >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.272-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.411-2.392-1.476-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-5.031 1.378c-3.055 2.2-3.797 6.1-1.658 9.118 2.14 3.017 6.08 3.756 9.134 1.554.822-.59 1.573-1.375 2.121-2.245l.001-.001a9.9 9.9 0 001.524-4.627c.029-.231.044-.465.044-.699 0-5.444-4.418-9.862-9.864-9.862 0 0-.501 0-.981.059a9.863 9.863 0 00-5.146 14.56M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0"></path>
                </svg>
                Fale conosco no WhatsApp
            </a>
        </div>
    </div>
</section>

<style>
    /* Animação de entrada */
    @keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .group {
        animation: slideUp 0.6s ease-out forwards;
        opacity: 0;
    }

    /* Efeito de hover nos cards */
    .group:hover {
        transform: translateY(-5px);
    }

    /* Garantir que gradientes funcionem no Safari */
    .bg-clip-text {
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .bg-gradient-to-r {
        background-image: linear-gradient(to right, var(--tw-gradient-stops));
    }

    .bg-gradient-to-br {
        background-image: linear-gradient(to bottom right, var(--tw-gradient-stops));
    }
</style>