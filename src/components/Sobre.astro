---
import Box from '../components/Box.astro'
---

<section class="about-section">
  <!-- Background com efeitos -->
  <div class="about-bg"></div>
  
  <div class="container">
    <!-- Conteúdo principal -->
    <div class="main-content">
      <!-- Lado esquerdo - Imagem com overlay -->
      <div class="image-container">
        <div class="image-overlay"></div>
        <img 
          src="/images/nos.png" 
          alt="Equipe Seitel Telecom" 
          class="team-image"
          loading="lazy"
        />
        
        <!-- Badge flutuante -->
        <div class="floating-badge">
          <div class="badge-icon">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" fill="currentColor"/>
            </svg>
          </div>
          <div class="badge-text">
            <span class="badge-number">35+</span>
            <span class="badge-label">Anos de História</span>
          </div>
        </div>
        
        <!-- Elementos decorativos -->
        <div class="deco-circle circle-1"></div>
        <div class="deco-circle circle-2"></div>
      </div>
      
      <!-- Lado direito - Conteúdo -->
      <div class="content-container">
        <div class="badge-top">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z" stroke="currentColor" stroke-width="2" fill="none"/>
          </svg>
          <span>FAÇA PARTE</span>
        </div>
        
        <h2 class="section-title">
          UM POUCO SOBRE <span class="title-highlight">NÓS</span>
        </h2>
        
        <div class="text-content">
          <p class="main-text">
            Há <strong>35 anos</strong>, a Seitel Telecom conecta pessoas, lares e empresas por meio de 
            soluções completas em telecomunicações. Nossa trajetória é construída com base em 
            <strong>confiança, inovação</strong> e no compromisso diário de oferecer conectividade 
            estável, segura e de qualidade.
          </p>
          
          <p class="highlight-text">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 6L9 17L4 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Acompanhando a evolução da tecnologia e das necessidades dos nossos clientes
          </p>
          
          <p class="main-text">
            Ao longo dessas três décadas, a Seitel evoluiu junto com seus clientes, investindo 
            continuamente em infraestrutura, inovação e melhoria dos serviços. Nosso propósito é 
            simples e sólido: <strong>conectar pessoas e negócios</strong> com confiança, desempenho 
            e visão de futuro.
          </p>
          
          <div class="quote-box">
            <div class="quote-icon">"</div>
            <p>
              Seitel Telecom é tecnologia que aproxima, protege e impulsiona, hoje, amanhã e nos 
              próximos anos.
            </p>
          </div>
          
          <p class="final-text">
            <strong>Seitel, conectando você ao que realmente importa.</strong><br/>
            Bem-vindo à Seitel Telecom!
          </p>
        </div>
        
        <a 
          href="https://wa.me/555136531254?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20os%20planos%20e%20benef%C3%ADcios%20da%20Seitel!" 
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button"
        >
          <span>ASSINE AGORA</span>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
    
    <!-- Cards de Missão, Visão e Valores -->
    <div class="values-grid">
      <div class="value-card">
        <div class="card-icon-wrapper">
          <div class="card-icon-bg"></div>
          <img src='/images/Wifi-bg.svg' alt="Missão" class="card-icon" />
        </div>
        <h3 class="card-title">NOSSA MISSÃO</h3>
        <p class="card-description">
          Promover, sob todas as circunstâncias, a melhor experiência em conectividade unindo as comunidades
        </p>
        <div class="card-shine"></div>
      </div>
      
      <div class="value-card">
        <div class="card-icon-wrapper">
          <div class="card-icon-bg"></div>
          <img src='/images/visao.svg' alt="Visão" class="card-icon" />
        </div>
        <h3 class="card-title">NOSSA VISÃO</h3>
        <p class="card-description">
          Ser Referência nacional no segmento de provedores de acesso à internet, destacando-se sempre pelo respeito, 
          comprometimento e serventia máxima ao cliente
        </p>
        <div class="card-shine"></div>
      </div>
      
      <div class="value-card">
        <div class="card-icon-wrapper">
          <div class="card-icon-bg"></div>
          <img src='/images/diamante.svg' alt="Valores" class="card-icon" />
        </div>
        <h3 class="card-title">NOSSOS VALORES</h3>
        <p class="card-description">
          Foco no cliente, compromisso, integridade, inovação e respeito.
        </p>
        <div class="card-shine"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Fix para imagem rotacionada no iOS
  document.addEventListener('DOMContentLoaded', function() {
    var teamImage = document.querySelector('.team-image');
    
    if (teamImage && /iPhone|iPad|iPod/.test(navigator.userAgent)) {
      // Força recarga da imagem sem metadados EXIF
      var src = teamImage.src;
      var img = new Image();
      
      img.onload = function() {
        var canvas = document.createElement('canvas');
        var ctx = canvas.getContext('2d');
        
        if (!ctx) return;
        
        // Define dimensões do canvas
        canvas.width = img.naturalWidth;
        canvas.height = img.naturalHeight;
        
        // Desenha imagem no canvas (isso remove metadados EXIF)
        ctx.drawImage(img, 0, 0);
        
        // Substitui a imagem pela versão do canvas
        teamImage.src = canvas.toDataURL('image/jpeg', 0.95);
      };
      
      img.src = src;
    }
  });
</script>

<style>
  .about-section {
    position: relative;
    padding: 5rem 0;
    overflow: hidden;
  }
  
  /* Background */
  .about-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 50%, #f8f9fa 100%);
    z-index: -1;
  }
  
  .about-bg::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.08) 0%, transparent 70%);
    border-radius: 50%;
  }
  
  .about-bg::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 153, 255, 0.06) 0%, transparent 70%);
    border-radius: 50%;
  }
  
  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
  }
  
  /* Conteúdo principal */
  .main-content {
    display: grid;
    grid-template-columns: 45% 55%;
    gap: 4rem;
    align-items: center;
    margin-bottom: 5rem;
  }
  
  /* Container da imagem - CORRIGIDO PARA iPHONE */
  .image-container {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
    /* Força o webkit a renderizar corretamente */
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    /* Adiciona contexto de empilhamento */
    isolation: isolate;
  }
  
  .team-image {
    width: 100%;
    height: 600px;
    object-fit: cover;
    display: block;
    /* CORREÇÃO PRINCIPAL: Ignora metadados EXIF */
    image-orientation: none;
    /* Força orientação correta no iOS */
    -webkit-transform: translateZ(0);
    transform: translateZ(0);
    /* Remove qualquer rotação automática */
    image-rendering: auto;
    -webkit-image-rendering: auto;
    /* Previne transformações inesperadas */
    will-change: transform;
  }
  
  .image-container:hover .team-image {
    transform: scale(1.05) translateZ(0);
  }
  
  .image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, rgba(0, 212, 255, 0.1) 0%, transparent 50%, rgba(0, 0, 0, 0.3) 100%);
    z-index: 1;
    pointer-events: none;
  }
  
  /* Badge flutuante */
  .floating-badge {
    position: absolute;
    bottom: 2rem;
    left: 2rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 1.25rem 1.75rem;
    border-radius: 16px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    z-index: 2;
    animation: floatBadge 3s ease-in-out infinite;
  }
  
  @keyframes floatBadge {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
  
  .badge-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #00d4ff 0%, #0099ff 100%);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
  }
  
  .badge-icon svg {
    width: 28px;
    height: 28px;
  }
  
  .badge-text {
    display: flex;
    flex-direction: column;
  }
  
  .badge-number {
    font-size: 1.75rem;
    font-weight: 900;
    color: #00d4ff;
    line-height: 1;
  }
  
  .badge-label {
    font-size: 0.85rem;
    color: #666;
    font-weight: 600;
  }
  
  /* Círculos decorativos */
  .deco-circle {
    position: absolute;
    border-radius: 50%;
    z-index: 0;
  }
  
  .circle-1 {
    width: 120px;
    height: 120px;
    background: rgba(0, 212, 255, 0.15);
    top: -30px;
    right: -30px;
    animation: pulse 4s ease-in-out infinite;
  }
  
  .circle-2 {
    width: 80px;
    height: 80px;
    background: rgba(0, 153, 255, 0.2);
    bottom: 100px;
    right: -20px;
    animation: pulse 4s ease-in-out infinite 2s;
  }
  
  @keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.2); opacity: 0.8; }
  }
  
  /* Container de conteúdo */
  .content-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .badge-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #00d4ff;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 1px;
    width: fit-content;
  }
  
  .badge-top svg {
    width: 20px;
    height: 20px;
  }
  
  .section-title {
    font-size: 3rem;
    font-weight: 900;
    color: #1a1a1a;
    line-height: 1.2;
    margin: 0;
  }
  
  .title-highlight {
    color: #00d4ff;
    position: relative;
    display: inline-block;
  }
  
  .title-highlight::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 8px;
    background: rgba(0, 212, 255, 0.2);
    z-index: -1;
  }
  
  /* Conteúdo de texto */
  .text-content {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  
  .main-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: #333;
    margin: 0;
  }
  
  .main-text strong {
    color: #00d4ff;
    font-weight: 700;
  }
  
  .highlight-text {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.1) 0%, rgba(0, 153, 255, 0.05) 100%);
    padding: 1rem 1.5rem;
    border-radius: 12px;
    border-left: 4px solid #00d4ff;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0;
  }
  
  .highlight-text svg {
    width: 24px;
    height: 24px;
    color: #00d4ff;
    flex-shrink: 0;
  }
  
  .quote-box {
    position: relative;
    background: #f8f9fa;
    padding: 1.75rem 2rem;
    border-radius: 16px;
    border: 2px solid #e9ecef;
    margin: 0.5rem 0;
  }
  
  .quote-icon {
    position: absolute;
    top: -15px;
    left: 20px;
    font-size: 4rem;
    color: #00d4ff;
    opacity: 0.3;
    font-family: Georgia, serif;
    line-height: 1;
  }
  
  .quote-box p {
    font-size: 1rem;
    line-height: 1.7;
    color: #555;
    margin: 0;
    font-style: italic;
    position: relative;
    z-index: 1;
  }
  
  .final-text {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
    margin: 0.5rem 0 0 0;
  }
  
  .final-text strong {
    color: #00d4ff;
    font-size: 1.15rem;
  }
  
  /* CTA Button */
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: linear-gradient(135deg, #00d4ff 0%, #0099ff 100%);
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 50px;
    border: none;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(0, 212, 255, 0.3);
    width: fit-content;
    margin-top: 1rem;
    text-decoration: none;
  }
  
  .cta-button svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }
  
  .cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(0, 212, 255, 0.4);
  }
  
  .cta-button:hover svg {
    transform: translateX(5px);
  }
  
  /* Grid de valores */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }
  
  .value-card {
    position: relative;
    background: white;
    padding: 2.5rem 2rem;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    transition: all 0.4s ease;
    overflow: hidden;
    border: 1px solid #f0f0f0;
  }
  
  .value-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 60px rgba(0, 212, 255, 0.15);
    border-color: #00d4ff;
  }
  
  .card-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    transition: left 0.5s ease;
  }
  
  .value-card:hover .card-shine {
    left: 100%;
  }
  
  .card-icon-wrapper {
    position: relative;
    width: 80px;
    height: 80px;
    margin-bottom: 1.5rem;
  }
  
  .card-icon-bg {
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.1) 0%, rgba(0, 153, 255, 0.05) 100%);
    border-radius: 16px;
    transition: all 0.3s ease;
  }
  
  .value-card:hover .card-icon-bg {
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(0, 153, 255, 0.1) 100%);
    transform: rotate(5deg) scale(1.1);
  }
  
  .card-icon {
    position: relative;
    width: 48px;
    height: 48px;
    margin: 16px;
    z-index: 1;
    filter: brightness(0) saturate(100%) invert(52%) sepia(98%) saturate(2572%) hue-rotate(167deg) brightness(101%) contrast(101%);
  }
  
  .card-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: #1a1a1a;
    margin: 0 0 1rem 0;
    letter-spacing: 0.5px;
  }
  
  .card-description {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #666;
    margin: 0;
  }
  
  /* Responsivo */
  @media (max-width: 1024px) {
    .main-content {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    
    .section-title {
      font-size: 2.5rem;
    }
    
    .values-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
  
  @media (max-width: 768px) {
    .about-section {
      padding: 3rem 0;
    }
    
    .container {
      padding: 0 1.5rem;
    }
    
    .section-title {
      font-size: 2rem;
    }
    
    /* FIX CRÍTICO: Ajusta container da imagem no mobile */
    .image-container {
      height: 450px;
      width: 100%;
    }
    
    .team-image {
      height: 100%;
      width: 100%;
      object-fit: cover;
      /* Force orientação portrait no mobile */
      max-height: 450px;
    }
    
    .floating-badge {
      padding: 1rem 1.25rem;
      bottom: 1rem;
      left: 1rem;
    }
    
    .badge-number {
      font-size: 1.5rem;
    }
    
    .main-content {
      margin-bottom: 3rem;
    }
  }
  
  /* Fix específico para iOS Safari - VERSÃO APRIMORADA */
  @supports (-webkit-touch-callout: none) {
    .image-container {
      /* Previne problemas de orientação */
      transform-style: preserve-3d;
      -webkit-transform-style: preserve-3d;
    }
    
    .team-image {
      /* Força a imagem a não rotacionar automaticamente no iOS */
      -webkit-transform: rotate(0deg) translateZ(0);
      transform: rotate(0deg) translateZ(0);
      /* Ignora metadados EXIF completamente */
      image-orientation: none !important;
    }
    
    .image-container:hover .team-image {
      -webkit-transform: scale(1.05) rotate(0deg) translateZ(0);
      transform: scale(1.05) rotate(0deg) translateZ(0);
    }
  }
</style>