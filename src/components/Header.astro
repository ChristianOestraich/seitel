<style>
    /* Reset para Safari/Opera */
    menu {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    
    nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    
    nav li {
        list-style: none;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }
    
    nav a {
        text-decoration: none;
        color: white;
        font-weight: 600;
    }
    
    /* Dropdown container */
    .dropdown-container {
        position: relative;
    }
    
    /* Dropdown menu */
    .dropdown-menu {
        position: absolute;
        left: 0;
        top: 100%;
        display: none;
        width: 14rem;
        background-color: white;
        color: black;
        padding: 0.5rem;
        border-radius: 0.375rem;
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        z-index: 100;
        margin-top: 0.5rem;
        list-style: none;
    }
    
    .dropdown-menu li {
        margin: 0;
        padding: 0;
        list-style: none;
    }
    
    .dropdown-item {
        display: block;
        text-align: center;
        padding: 0.5rem 1rem;
        color: #1fc9e0 !important;
        border-radius: 0.25rem;
        transition: background-color 0.2s;
        text-decoration: none;
        font-weight: 600;
    }
    
    .dropdown-item:hover {
        background-color: #e5e7eb;
    }
    
    /* Mostrar dropdown no hover (desktop) */
    .dropdown-container:hover .dropdown-menu {
        display: block;
    }
    
    /* Rotação da seta */
    .dropdown-arrow {
        transition: transform 0.3s ease;
        -webkit-transition: -webkit-transform 0.3s ease;
    }
    
    .dropdown-container:hover .dropdown-arrow {
        transform: rotate(180deg);
        -webkit-transform: rotate(180deg);
    }
    
    /* Mobile menu */
    #collapseMenu.show {
        display: flex !important;
        flex-direction: column;
    }
    
    /* Dropdown no mobile */
    @media (max-width: 768px) {
        .dropdown-menu {
            position: static;
            width: 100%;
            box-shadow: none;
            background-color: rgba(255, 255, 255, 0.1);
            margin-top: 0.5rem;
        }
        
        .dropdown-item {
            color: white !important;
        }
        
        .dropdown-item:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }
    }
    
    /* Garantir que gradientes funcionem no Safari */
    .bg-gradient-to-b {
        background-image: linear-gradient(to bottom, var(--tw-gradient-stops));
        -webkit-background-clip: padding-box;
        background-clip: padding-box;
    }
</style>

<script>
    // Menu toggle para mobile
    const menuToggle = document.getElementById('menuToggle');
    const collapseMenu = document.getElementById('collapseMenu');
    
    if (menuToggle && collapseMenu) {
        menuToggle.addEventListener('click', () => {
            collapseMenu.classList.toggle('hidden');
            collapseMenu.classList.toggle('show');
        });
    }
    
    // Toggle do dropdown no mobile (click)
    document.addEventListener('DOMContentLoaded', () => {
        const dropdownTrigger = document.querySelector('.dropdown-trigger');
        const dropdownMenu = document.querySelector('.dropdown-menu');
        
        if (dropdownTrigger && dropdownMenu) {
            dropdownTrigger.addEventListener('click', (e) => {
                // Só funciona no mobile
                if (window.innerWidth < 768) {
                    e.preventDefault();
                    
                    // Type assertion para Element
                    const menu = dropdownMenu as HTMLElement;
                    
                    if (menu.style.display === 'block') {
                        menu.style.display = 'none';
                    } else {
                        menu.style.display = 'block';
                    }
                }
            });
        }
    });
</script>