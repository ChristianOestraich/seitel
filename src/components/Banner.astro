---
interface Props {
    href: string;
}

const { href } = Astro.props;
---

<video 
    class="w-full h-auto hidden md:block max-lg:hidden object-cover" 
    style="aspect-ratio: 16/9; max-height: 90vh;"
    src={href} 
    autoplay 
    loop 
    muted 
    playsinline 
    webkit-playsinline
    controlslist="nodownload"
    disablepictureinpicture
    preload="auto"
>
    Banner não disponível
</video>

<style>
    /* Correções específicas para Safari e Opera */
    video {
        -webkit-transform: translateZ(0);
        transform: translateZ(0);
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }
    
    /* Garantir que o vídeo não ultrapasse os limites */
    video {
        display: block;
        width: 100%;
        height: auto;
    }
</style>

<script>
    // Garantir autoplay no Safari/Opera
    document.addEventListener('DOMContentLoaded', () => {
        const videos = document.querySelectorAll('video');
        videos.forEach(video => {
            // Força o play após um delay mínimo
            setTimeout(() => {
                video.play().catch(err => {
                    console.log('Autoplay foi bloqueado:', err);
                });
            }, 100);
            
            // Garante que o vídeo sempre esteja mutado (requisito para autoplay)
            video.muted = true;
            video.volume = 0;
        });
    });
</script>