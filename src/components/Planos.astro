---

<!-- Seção de Planos de Internet e Câmeras -->
<section class="w-full bg-gradient-to-br from-gray-900 via-black to-gray-900 py-16 md:py-24 relative overflow-hidden">
  <!-- Efeito de brilho de fundo -->
  <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 via-purple-500/10 to-pink-500/10 blur-3xl"></div>
  
  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <!-- Título e Descrição -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">
        Planos de
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
          Internet e Câmeras
        </span>
      </h2>
      <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto">
        Conecte-se ao que há de melhor em internet fibra óptica e monitore sua casa com segurança!
      </p>
    </div>

    <!-- Carrossel de Planos -->
    <div class="glide py-12">
      <div class="glide__track" data-glide-el="track">
        <ul class="glide__slides">
          {planos.map((plano, index) => (
            <li class="glide__slide">
              <div class="flip-card h-[580px]" data-card-index={index}>
                <div class="flip-card-inner">
                  <!-- FRENTE DO CARD -->
                  <div class="flip-card-front">
                    <!-- Borda gradiente externa -->
                    <div class={`absolute -inset-1 rounded-2xl blur opacity-30 group-hover:opacity-60 transition duration-500 ${plano.tipo === 'camera' ? 'bg-gradient-to-r from-orange-500 via-red-500 to-pink-600' : 'bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-600'}`}></div>
                    
                    <div class={`relative backdrop-blur-sm rounded-2xl shadow-2xl p-8 h-full flex flex-col items-center justify-between transition-all duration-300 ${plano.tipo === 'camera' ? 'bg-gradient-to-br from-gray-800/90 to-gray-900/90 border border-orange-500/30 hover:border-orange-400/60' : 'bg-gradient-to-br from-gray-800/90 to-gray-900/90 border border-cyan-500/30 hover:border-cyan-400/60'}`}>
                      
                      <!-- Badge de tipo -->
                      {plano.tipo === 'camera' && (
                        <div class="absolute top-4 right-4 bg-gradient-to-r from-orange-500 to-red-600 text-white px-3 py-1 rounded-full text-xs font-bold">
                          CÂMERAS
                        </div>
                      )}

                      <!-- Velocidade ou Quantidade de Câmeras -->
                      <div class="text-center">
                        {plano.tipo === 'internet' ? (
                          <h3 class="text-6xl font-bold text-white mb-2">
                            {plano.mega}<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">{plano.unidade}</span>
                          </h3>
                        ) : (
                          <div class="mb-2">
                            <h3 class="text-6xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-500">
                              CAM
                            </h3>
                            <p class="text-gray-400 text-xs mt-1 opacity-60">Planos a partir de R$ 129,90</p>
                          </div>
                        )}
                        {plano.tipo === 'internet' && (
                          <div class="flex items-baseline justify-center gap-1 mb-2 flex-wrap">
                            <span class="text-gray-400 text-sm">Por apenas</span>
                            <span class="font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500" style="font-size: 1.7rem; line-height: 1;">R$ {plano.valor}</span>
                            <span class="text-gray-400 text-sm">/mês</span>
                          </div>
                        )}
                      </div>

                      {/* Ícones dos streamings (apenas para internet) */}
                      {plano.tipo === 'internet' && plano.streamings && (
                        <div class="flex gap-3 justify-center items-center flex-wrap max-w-[280px] my-4">
                          {plano.streamings.map((streaming) => (
                            <div class="streaming-icon-container w-14 h-14 bg-white/10 backdrop-blur-md rounded-xl flex items-center justify-center hover:bg-white/20 hover:scale-110 transition-all duration-300 overflow-hidden">
                              <img src={streaming} alt="Benefício" class="w-full h-full object-cover rounded-xl" loading="lazy" />
                            </div>
                          ))}
                        </div>
                      )}

                      {/* Ícone de câmera (para planos de câmera) */}
                      {plano.tipo === 'camera' && (
                        <div class="my-4">
                          <div class="w-20 h-20 bg-gradient-to-br from-orange-500 to-red-600 rounded-full flex items-center justify-center mx-auto">
                            <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                            </svg>
                          </div>
                        </div>
                      )}

                      <!-- Lista de benefícios em texto -->
                      <div class="space-y-3 w-full">
                        {plano.textos.map((texto) => (
                          <div class="flex items-center gap-3 text-sm text-gray-200 bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-3 hover:bg-white/10 transition-all duration-300">
                            <div class={`w-5 h-5 rounded-full flex items-center justify-center flex-shrink-0 ${plano.tipo === 'camera' ? 'bg-gradient-to-br from-orange-500 to-red-600' : 'bg-gradient-to-br from-cyan-500 to-blue-600'}`}>
                              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                              </svg>
                            </div>
                            <span class="font-medium">{texto}</span>
                          </div>
                        ))}
                      </div>

                      {/* Extras (se houver) */}
                      {plano.extras && (
                        <div class="w-full space-y-2">
                          <div class="bg-gradient-to-r from-cyan-500 to-blue-600 text-white text-center py-2.5 rounded-xl text-sm font-bold shadow-lg">
                            SEGUNDO ROTEADOR
                          </div>
                          <div class="text-center font-bold text-gray-300 text-sm py-1">
                            {plano.extras.ou}
                          </div>
                          <div class="bg-gradient-to-r from-purple-500 to-pink-600 text-white text-center py-2.5 rounded-xl text-sm font-bold shadow-lg">
                            CONVERSOR DE SMART
                          </div>
                        </div>
                      )}

                      <!-- Botão com gradiente -->
                      <button 
                        type="button"
                        class={`flip-button w-full font-bold py-4 px-6 rounded-xl transition-all duration-300 shadow-xl transform hover:scale-105 uppercase text-sm ${plano.tipo === 'camera' ? 'bg-gradient-to-r from-orange-500 to-red-600 hover:from-orange-600 hover:to-red-700 text-white hover:shadow-orange-500/50' : 'bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white hover:shadow-cyan-500/50'}`}>
                        <span class="flex items-center justify-center gap-2">
                          {plano.tipo === 'camera' ? (
                            <>
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                              </svg>
                              Ver Detalhes
                            </>
                          ) : (
                            <>
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                              </svg>
                              Assine Já
                            </>
                          )}
                        </span>
                      </button>

                      <!-- Consulte condições -->
                      <p class="text-xs text-gray-500 text-center mt-2">Consulte condições</p>
                    </div>
                  </div>

                  <!-- VERSO DO CARD -->
                  <div class="flip-card-back">
                    {/* Borda gradiente apenas para câmeras */}
                    {plano.tipo === 'camera' && (
                      <div class="absolute -inset-1 rounded-2xl blur opacity-40 bg-gradient-to-r from-orange-500 via-red-500 to-pink-600"></div>
                    )}
                    
                    <div class={`relative rounded-2xl shadow-2xl p-8 h-full flex flex-col justify-between ${plano.tipo === 'camera' ? 'bg-gradient-to-br from-orange-600 via-red-600 to-pink-700 border border-orange-400/30 text-white' : 'bg-white text-gray-800 border border-gray-200'}`}>
                      
                      {/* VERSO - PLANOS DE INTERNET */}
                      {plano.tipo === 'internet' && (
                        <>
                          <!-- Cabeçalho com Plano e Valor -->
                          <div class="text-center py-6 border-b border-gray-200">
                            <h3 class="text-4xl font-bold text-gray-800 mb-2">
                              {plano.mega}<span class="text-cyan-500">{plano.unidade}</span>
                            </h3>
                            <div class="flex items-baseline justify-center gap-1">
                              <span class="text-gray-600 text-sm">R$</span>
                              <span class="text-3xl font-bold text-cyan-600">{plano.valor}</span>
                              <span class="text-gray-600 text-sm">/mês</span>
                            </div>
                          </div>

                          <!-- Lista de benefícios - Simples e Clean -->
                          <div class="flex flex-col justify-center space-y-5 py-6">
                            {/* Fibra óptica de ponta a ponta */}
                            <div class="flex items-center gap-4">
                              <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                              </div>
                              <span class="text-sm text-gray-700">Fibra óptica de ponta a ponta</span>
                            </div>

                            {/* Suporte técnico 24 horas */}
                            <div class="flex items-center gap-4">
                              <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                </svg>
                              </div>
                              <span class="text-sm text-gray-700">Suporte técnico 24 horas, 7 dias por semana</span>
                            </div>

                            {/* Wi-Fi 6 */}
                            <div class="flex items-center gap-4">
                              <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
                                </svg>
                              </div>
                              <span class="text-sm text-gray-700">Wi-Fi 6</span>
                            </div>

                            {/* Instalação Grátis */}
                            <div class="flex items-center gap-4">
                              <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                </svg>
                              </div>
                              <span class="text-sm text-gray-700">Instalação Grátis</span>
                            </div>
                          </div>

                          <!-- Texto de consulta de valores -->
                          <div class="text-center py-3">
                            <p class="text-xs text-gray-500">
                              *Consulte valores da sua região
                            </p>
                          </div>

                          <!-- Botão de contato -->
                          <div class="px-2 pb-4">
                            <a href="https://wa.me/555136531254?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20os%20planos%20e%20benef%C3%ADcios%20da%20Seitel!" class="block w-full bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-bold py-3.5 px-6 rounded-xl hover:from-cyan-600 hover:to-blue-700 transition-all duration-300 shadow-lg text-center text-sm uppercase">
                              Contratar Agora
                            </a>
                          </div>
                        </>
                      )}

                      {/* VERSO - PLANOS DE CÂMERAS */}
                      {plano.tipo === 'camera' && (
                        <>
                          <!-- Cabeçalho -->
                          <div class="text-center border-b border-white/30 pb-4">
                            <div class="inline-block bg-white/20 backdrop-blur-md px-4 py-1 rounded-full mb-3">
                              <span class="text-xs font-bold uppercase tracking-wide">Plano de Segurança</span>
                            </div>
                          </div>

                          <!-- Todos os benefícios -->
                          <div class="flex-1 py-6 overflow-y-auto custom-scrollbar">
                            <h4 class="font-bold text-lg mb-4 text-center flex items-center justify-center gap-2">
                              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                              </svg>
                              Tudo que está incluso
                            </h4>

                            {/* Lista de benefícios */}
                            <div class="space-y-2.5">
                              {plano.beneficios.map((beneficio) => (
                                <div class="flex items-start gap-3 bg-white/15 backdrop-blur-sm rounded-lg p-3 border border-white/20 hover:bg-white/25 transition-all duration-300">
                                  <div class="w-5 h-5 bg-green-400 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg class="w-3 h-3 text-green-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                  </div>
                                  <span class="text-sm font-medium leading-tight">{beneficio}</span>
                                </div>
                              ))}
                            </div>
                          </div>

                          <!-- Texto de consulta de valores para câmeras -->
                          <div class="mb-3">
                            <p class="text-sm font-semibold bg-white/20 backdrop-blur-sm rounded-lg py-3 px-4 border border-white/30 text-center">
                              Consulte valores da sua região
                            </p>
                          </div>

                          <!-- Botão de contato -->
                          <div class="space-y-3">
                            <a href="/cameras" class="block w-full bg-white text-orange-600 font-bold py-4 px-8 rounded-xl hover:bg-gray-100 transition-all duration-300 shadow-2xl text-center uppercase text-sm transform hover:scale-105">
                              <span class="flex items-center justify-center gap-2">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                                </svg>
                                Saiba Mais Sobre Câmeras
                              </span>
                            </a>
                            <p class="text-xs text-center opacity-80 flex items-center justify-center gap-1">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                              </svg>
                              Clique para ver mais detalhes
                            </p>
                          </div>
                        </>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

