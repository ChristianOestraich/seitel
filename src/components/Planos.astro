---

<!-- Seção de Planos de Internet -->
<section class="w-full bg-gradient-to-br from-gray-900 via-black to-gray-900 py-16 md:py-24 relative overflow-hidden">
  <!-- Efeito de brilho de fundo -->
  <div class="absolute inset-0 bg-gradient-to-r from-cyan-500/10 via-purple-500/10 to-pink-500/10 blur-3xl"></div>
  
  <div class="container mx-auto px-6 md:px-12 relative z-10">
    <!-- Título e Descrição -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-5xl font-bold text-white mb-4">
        Planos de
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
          Internet
        </span>
      </h2>
      <p class="text-gray-300 text-lg md:text-xl max-w-3xl mx-auto">
        Conecte-se ao que há de melhor em internet fibra óptica!
      </p>
    </div>

    <!-- Carrossel de Planos -->
    <div class="glide py-12">
      <div class="glide__track" data-glide-el="track">
        <ul class="glide__slides">
          {planos.map((plano, index) => (
            <li class="glide__slide">
              <div class="flip-card h-[580px]">
                <div class="flip-card-inner">
                  <!-- FRENTE DO CARD -->
                  <div class="flip-card-front">
                    <!-- Borda gradiente externa -->
                    <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-600 rounded-2xl blur opacity-30 group-hover:opacity-60 transition duration-500"></div>
                    
                    <div class="relative bg-gradient-to-br from-gray-800/90 to-gray-900/90 backdrop-blur-sm rounded-2xl shadow-2xl p-4 h-full flex flex-col items-center justify-between border border-cyan-500/30 hover:border-cyan-400/60 transition-all duration-300">
                      
                      <!-- Velocidade -->
                      <div class="text-center">
                        <h3 class="text-6xl font-bold text-white mb-2">
                          {plano.mega}<span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">{plano.unidade}</span>
                        </h3>
                        <div class="flex items-center justify-center gap-2 mb-2">
                          <span class="text-gray-400 text-sm">Por apenas</span>
                          <span class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">R$ {plano.valor}</span>
                          <span class="text-gray-400 text-sm">/mês</span>
                        </div>
                      </div>

                      <!-- Ícones dos streamings com efeito glass -->
                      <div class="flex gap-3 justify-center items-center flex-wrap max-w-[280px] my-4">
                        {plano.streamings.map((streaming) => (
                          <div class="streaming-icon-container w-14 h-14 bg-white/10 backdrop-blur-md border border-white/20 rounded-xl flex items-center justify-center hover:bg-white/20 hover:scale-110 transition-all duration-300">
                            <img src={streaming} alt="Benefício" class="max-w-[85%] max-h-[85%] object-contain" />
                          </div>
                        ))}
                      </div>

                      <!-- Lista de benefícios em texto -->
                      <div class="space-y-3 w-full">
                        {plano.textos.map((texto) => (
                          <div class="flex items-center gap-3 text-sm text-gray-200 bg-white/5 backdrop-blur-sm border border-white/10 rounded-lg p-3 hover:bg-white/10 transition-all duration-300">
                            <div class="w-5 h-5 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-full flex items-center justify-center flex-shrink-0">
                              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                              </svg>
                            </div>
                            <span class="font-medium">{texto}</span>
                          </div>
                        ))}
                      </div>

                      {/* Extras (se houver) */}
                      {plano.extras && (
                        <div class="w-full space-y-2">
                          <div class="bg-gradient-to-r from-cyan-500 to-blue-600 text-white text-center py-2.5 rounded-xl text-sm font-bold shadow-lg">
                            SEGUNDO ROTEADOR
                          </div>
                          <div class="text-center font-bold text-gray-300 text-sm py-1">
                            {plano.extras.ou}
                          </div>
                          <div class="bg-gradient-to-r from-purple-500 to-pink-600 text-white text-center py-2.5 rounded-xl text-sm font-bold shadow-lg">
                            CONVERSOR DE SMART
                          </div>
                        </div>
                      )}

                      <!-- Botão com gradiente -->
                      <button class="w-full bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white font-bold py-4 px-6 rounded-xl transition-all duration-300 shadow-xl hover:shadow-cyan-500/50 transform hover:scale-105 uppercase text-sm">
                        <span class="flex items-center justify-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                          </svg>
                          Assine Já
                        </span>
                      </button>

                      <!-- Consulte condições -->
                      <p class="text-xs text-gray-500 text-center mt-2">Consulte condições</p>
                    </div>
                  </div>

                  <!-- VERSO DO CARD -->
                  <div class="flip-card-back">
                    <!-- Borda gradiente externa -->
                    <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-600 rounded-2xl blur opacity-40"></div>
                    
                    <div class="relative bg-gradient-to-br from-cyan-600 via-blue-600 to-purple-700 rounded-2xl shadow-2xl p-4 h-full flex flex-col justify-between text-white border border-cyan-400/30">
                      
                      <!-- Cabeçalho -->
                      <div class="text-center border-b border-white/30 pb-4">
                        <div class="inline-block bg-white/20 backdrop-blur-md px-4 py-1 rounded-full mb-3">
                          <span class="text-xs font-bold uppercase tracking-wide">Plano Completo</span>
                        </div>
                        <h3 class="text-5xl font-bold mb-2">
                          {plano.mega}<span class="text-white/90">{plano.unidade}</span>
                        </h3>
                        <p class="text-2xl font-semibold">R$ {plano.valor}<span class="text-sm font-normal opacity-80">/mês</span></p>
                      </div>

                      <!-- Todos os benefícios -->
                      <div class="flex-1 py-6 overflow-y-auto custom-scrollbar">
                        <h4 class="font-bold text-lg mb-4 text-center flex items-center justify-center gap-2">
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"></path>
                          </svg>
                          Tudo que está incluso
                        </h4>
                        
                        {/* Grid de streamings */}
                        <div class="grid grid-cols-3 gap-3 mb-5">
                          {plano.streamings.map((streaming) => (
                            <div class="streaming-back-container bg-white/25 backdrop-blur-md rounded-xl p-3 flex items-center justify-center h-16 border border-white/20 hover:bg-white/35 transition-all duration-300">
                              <img src={streaming} alt="Streaming" class="max-h-10 max-w-full object-contain" />
                            </div>
                          ))}
                        </div>

                        {/* Lista de benefícios */}
                        <div class="space-y-2.5">
                          {plano.beneficios.map((beneficio) => (
                            <div class="flex items-start gap-3 bg-white/15 backdrop-blur-sm rounded-lg p-3 border border-white/20 hover:bg-white/25 transition-all duration-300">
                              <div class="w-5 h-5 bg-green-400 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                                <svg class="w-3 h-3 text-green-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                                </svg>
                              </div>
                              <span class="text-sm font-medium leading-tight">{beneficio}</span>
                            </div>
                          ))}
                        </div>
                      </div>

                      <!-- Botão de contato -->
                      <div class="space-y-3">
                        <a href="https://wa.me/555136531254?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20os%20planos%20e%20benef%C3%ADcios%20da%20Seitel!" class="block w-full bg-white text-blue-600 font-bold py-4 px-8 rounded-xl hover:bg-gray-100 transition-all duration-300 shadow-2xl text-center uppercase text-sm transform hover:scale-105">
                          <span class="flex items-center justify-center gap-2">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
                            </svg>
                            Contratar Agora
                          </span>
                        </a>
                        <p class="text-xs text-center opacity-80 flex items-center justify-center gap-1">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                          </svg>
                          Clique para ver mais detalhes
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Controles de navegação modernos -->
      <div class="glide__arrows" data-glide-el="controls">
        <button class="glide__arrow glide__arrow--left bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-full w-12 h-12 md:w-14 md:h-14 flex items-center justify-center hover:from-cyan-600 hover:to-blue-700 transition-all shadow-xl hover:shadow-cyan-500/50 transform hover:scale-110" data-glide-dir="<">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>
        <button class="glide__arrow glide__arrow--right bg-gradient-to-r from-cyan-500 to-blue-600 text-white rounded-full w-12 h-12 md:w-14 md:h-14 flex items-center justify-center hover:from-cyan-600 hover:to-blue-700 transition-all shadow-xl hover:shadow-cyan-500/50 transform hover:scale-110" data-glide-dir=">">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>

      <!-- Indicadores modernos -->
      <div class="glide__bullets flex justify-center gap-2 mt-8" data-glide-el="controls[nav]">
        {planos.map((_, index) => (
          <button class="glide__bullet w-3 h-3 rounded-full bg-gray-600 hover:bg-cyan-400 transition-all duration-300" data-glide-dir={`=${index}`}></button>
        ))}
      </div>
    </div>

    <!-- Features adicionais -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mt-16">
      <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm border border-cyan-500/30 rounded-xl p-6 text-center hover:border-cyan-400 transition duration-300 group">
        <div class="w-16 h-16 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Velocidade Máxima</h3>
        <p class="text-gray-400">Internet de fibra óptica para streaming em 4K sem travamentos</p>
      </div>

      <div class="bg-gradient-to-br from-gray-800/50 to-gray-900/50 backdrop-blur-sm border border-purple-500/30 rounded-xl p-6 text-center hover:border-purple-400 transition duration-300 group">
        <div class="w-16 h-16 bg-gradient-to-br from-purple-500 to-pink-600 rounded-full flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition-transform duration-300">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Sem Limite de Dados</h3>
