<style>
  /* ===========================================
     CORREÇÕES ESPECÍFICAS PARA SAFARI/OPERA
     =========================================== */
  
  /* Flip Card Styles - Com correções para Safari */
  .flip-card {
    perspective: 1000px;
    cursor: pointer;
    -webkit-perspective: 1000px;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.4, 0.0, 0.2, 1);
    transform-style: preserve-3d;
    -webkit-transform-style: preserve-3d;
    -webkit-transition: -webkit-transform 0.8s cubic-bezier(0.4, 0.0, 0.2, 1);
  }

  .flip-card:hover .flip-card-inner,
  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    -moz-backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
    -webkit-transform: rotateY(180deg);
  }

  /* Custom Scrollbar para o verso do card */
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  /* Glide Customization */
  .glide__arrow {
    border: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    -webkit-transform: translateY(-50%);
    z-index: 10;
  }

  .glide__arrow--left {
    left: -70px;
  }

  .glide__arrow--right {
    right: -70px;
  }

  .glide__bullet--active {
    background: linear-gradient(to right, #06b6d4, #3b82f6) !important;
    transform: scale(1.5);
    -webkit-transform: scale(1.5);
    width: 24px;
    border-radius: 10px;
  }

  @media (max-width: 768px) {
    .glide__arrow--left {
      left: 10px;
    }
    .glide__arrow--right {
      right: 10px;
    }
  }

  /* Animações suaves - com prefixos para Safari */
  @keyframes float {
    0%, 100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  @-webkit-keyframes float {
    0%, 100% {
      -webkit-transform: translateY(0px);
    }
    50% {
      -webkit-transform: translateY(-10px);
    }
  }

  .flip-card:hover .streaming-icon-container {
    animation: float 2s ease-in-out infinite;
    -webkit-animation: float 2s ease-in-out infinite;
  }

  /* Garantir qualidade das imagens */
  .flip-card img {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }

  /* Garantir que gradientes funcionem no Safari/Opera */
  .bg-gradient-to-r,
  .bg-gradient-to-br,
  .bg-gradient-to-b {
    -webkit-background-clip: padding-box;
    background-clip: padding-box;
  }

  .text-transparent {
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .bg-clip-text {
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* Garantir que backdrop-filter funcione */
  .backdrop-blur-sm,
  .backdrop-blur-md {
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
</style>

<script>
  // Funcionalidade de clique para dispositivos móveis e desktop
  // Com correções para Safari/Opera
  document.addEventListener('DOMContentLoaded', () => {
    const flipCards = document.querySelectorAll('.flip-card');
    
    flipCards.forEach(card => {
      const flipButton = card.querySelector('.flip-button');
      
      // Prevenir que o hover funcione em dispositivos touch
      if ('ontouchstart' in window) {
        card.addEventListener('touchstart', (e) => {
          e.preventDefault();
          card.classList.toggle('flipped');
        });
      }
      
      // Click para desktop
      if (flipButton) {
        flipButton.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          
          const parentCard = (e.target as HTMLElement).closest('.flip-card');
          if (parentCard) {
            parentCard.classList.toggle('flipped');
          }
        });
      }
      
      // Fallback para navegadores que não suportam bem o hover
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        
        // Ignora cliques em links e botões de ação
        if (target && target.closest('a[href]') && !target.closest('.flip-button')) {
          return;
        }
        
        // Ignora cliques no botão de flip (já tratado acima)
        if (target && target.closest('.flip-button')) {
          return;
        }
        
        card.classList.toggle('flipped');
      });
    });
  });
</script>