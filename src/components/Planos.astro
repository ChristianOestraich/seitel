---

<section class="px-[6%] py-12 bg-gray-50">
  <div class="mb-12">
    <h2 class="text-[#293659] font-bold text-4xl text-center uppercase">PLANOS DE INTERNET</h2>
    <h3 class="text-center text-base text-[#0280d8] mt-2">Conecte-se ao que há de melhor em internet fibra óptica!</h3>
  </div>

  <div class="glide py-12">
    <div class="glide__track" data-glide-el="track">
      <ul class="glide__slides">
        {planos.map((plano, index) => (
          <li class="glide__slide">
            <div class="flip-card h-[520px]">
              <div class="flip-card-inner">
                <!-- FRENTE DO CARD -->
                <div class="flip-card-front">
                  <div class="bg-white rounded-3xl shadow-md p-8 h-full flex flex-col items-center justify-between border-2 border-[#0280d8] hover:shadow-xl transition-all duration-300">
                    
                    <!-- Velocidade -->
                    <div class="text-center">
                      <h3 class="text-6xl font-bold text-[#293659] mb-2">
                        {plano.mega}<span class="text-[#0280d8]">{plano.unidade}</span>
                      </h3>
                      <p class="text-gray-600 text-sm">Por R${plano.valor}</p>
                    </div>

                    <!-- Ícones dos streamings -->
                    <div class="flex gap-2 justify-center items-center flex-wrap max-w-[200px]">
                      {plano.streamings.map((streaming) => (
                        <div class="w-12 h-12 flex items-center justify-center">
                          <img src={streaming} alt="Benefício" class="max-w-full max-h-full object-contain" />
                        </div>
                      ))}
                    </div>

                    <!-- Lista de benefícios em texto -->
                    <div class="space-y-2 w-full">
                      {plano.textos.map((texto) => (
                        <div class="flex items-center gap-2 text-sm text-gray-700">
                          <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                          <span>{texto}</span>
                        </div>
                      ))}
                    </div>

                    {/* Extras (se houver) */}
                    {plano.extras && (
                      <div class="w-full">
                        <div class="bg-[#293659] text-white text-center py-2 rounded-full text-sm font-semibold mb-2">
                          SEGUNDO ROTEADOR
                        </div>
                        <div class="text-center font-bold text-gray-600 text-sm mb-2">
                          {plano.extras.ou}
                        </div>
                        <div class="bg-[#293659] text-white text-center py-2 rounded-full text-sm font-semibold">
                          CONVERSOR DE SMART
                        </div>
                      </div>
                    )}

                    <!-- Botão -->
                    <button class="w-full bg-[#0280d8] hover:bg-[#0270c0] text-white font-bold py-3 px-6 rounded-full transition-all duration-300 shadow-md hover:shadow-lg uppercase text-sm">
                      Assine Já
                    </button>

                    <!-- Consulte condições -->
                    <p class="text-xs text-gray-500 text-center">Consulte condições</p>
                  </div>
                </div>

                <!-- VERSO DO CARD -->
                <div class="flip-card-back">
                  <div class="bg-gradient-to-br from-[#0280d8] to-[#0260a8] rounded-3xl shadow-xl p-8 h-full flex flex-col justify-between text-white">
                    
                    <!-- Cabeçalho -->
                    <div class="text-center border-b border-white/30 pb-4">
                      <h3 class="text-5xl font-bold mb-2">
                        {plano.mega}<span class="text-white/90">{plano.unidade}</span>
                      </h3>
                      <p class="text-2xl font-semibold">R$ {plano.valor}<span class="text-sm font-normal">/mês</span></p>
                    </div>

                    <!-- Todos os benefícios -->
                    <div class="flex-1 py-6 overflow-y-auto">
                      <h4 class="font-bold text-lg mb-4 text-center">✨ Tudo que está incluso:</h4>
                      
                      {/* Grid de streamings */}
                      <div class="grid grid-cols-3 gap-3 mb-4">
                        {plano.streamings.map((streaming) => (
                          <div class="bg-white/20 backdrop-blur-sm rounded-xl p-3 flex items-center justify-center h-16">
                            <img src={streaming} alt="Streaming" class="max-h-10 max-w-full object-contain" />
                          </div>
                        ))}
                      </div>

                      {/* Lista de benefícios */}
                      <div class="space-y-3 mt-4">
                        {plano.beneficios.map((beneficio) => (
                          <div class="flex items-start gap-3 bg-white/10 rounded-lg p-3">
                            <svg class="w-5 h-5 text-green-300 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span class="text-sm font-medium">{beneficio}</span>
                          </div>
                        ))}
                      </div>
                    </div>

                    <!-- Botão de contato -->
                    <div class="space-y-3">
                      <a href="https://wa.me/555136531254?text=Ol%C3%A1%20gostaria%20de%20saber%20mais%20sobre%20os%20planos%20e%20benef%C3%ADcios%20da%20Seitel!" class="block w-full bg-white text-[#0280d8] font-bold py-3 px-8 rounded-full hover:bg-gray-100 transition-all duration-300 shadow-lg text-center uppercase text-sm">
                        Contratar Agora
                      </a>
                      <p class="text-xs text-center opacity-80">Clique para voltar</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Controles de navegação -->
    <div class="glide__arrows" data-glide-el="controls">
      <button class="glide__arrow glide__arrow--left bg-white border-2 border-[#0280d8] text-[#0280d8] rounded-full w-12 h-12 flex items-center justify-center hover:bg-[#0280d8] hover:text-white transition-all shadow-lg font-bold text-xl" data-glide-dir="<">←</button>
      <button class="glide__arrow glide__arrow--right bg-white border-2 border-[#0280d8] text-[#0280d8] rounded-full w-12 h-12 flex items-center justify-center hover:bg-[#0280d8] hover:text-white transition-all shadow-lg font-bold text-xl" data-glide-dir=">">→</button>
    </div>

    <!-- Indicadores -->
    <div class="glide__bullets flex justify-center gap-2 mt-6" data-glide-el="controls[nav]">
      {planos.map((_, index) => (
        <button class="glide__bullet w-3 h-3 rounded-full bg-gray-300 hover:bg-[#0280d8] transition-all" data-glide-dir={`=${index}`}></button>
      ))}
    </div>
  </div>
</section>

<style>
  /* Flip Card Styles */
  .flip-card {
    perspective: 1000px;
    cursor: pointer;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.6s;
    transform-style: preserve-3d;
  }

  .flip-card:hover .flip-card-inner,
  .flip-card.flipped .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-front,
  .flip-card-back {
    position: absolute;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  .flip-card-back {
    transform: rotateY(180deg);
  }

  /* Glide Customization */
  .glide__arrow {
    border: none;
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
  }

  .glide__arrow--left {
    left: -60px;
  }

  .glide__arrow--right {
    right: -60px;
  }

  .glide__bullet--active {
    background-color: #0280d8 !important;
    transform: scale(1.3);
  }

  @media (max-width: 768px) {
    .glide__arrow--left {
      left: 10px;
    }
    .glide__arrow--right {
      right: 10px;
    }
  }

  /* Garantir que os ícones das imagens mantenham proporção */
  .flip-card img {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }
</style>

<script>
  // Adicionar funcionalidade de clique para dispositivos móveis
  document.addEventListener('DOMContentLoaded', () => {
    const flipCards = document.querySelectorAll('.flip-card');
    
    flipCards.forEach(card => {
      card.addEventListener('click', () => {
        card.classList.toggle('flipped');
      });
    });
  });
</script>