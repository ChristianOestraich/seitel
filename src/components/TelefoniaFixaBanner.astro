
---
// TelefoniaFixaBanner.astro
// Banner moderno para Telefonia Fixa
---

<section class="telefonia-banner">
  <div class="banner-container">
    <!-- Background animado -->
    <div class="animated-bg"></div>
    
    <!-- Ondas de conectividade -->
    <canvas id="connectivityCanvas" class="connectivity-canvas"></canvas>
    
    <!-- Conteúdo principal -->
    <div class="content-wrapper">
      <!-- Lado esquerdo - Informações -->
      <div class="info-section">
        <div class="badge">
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M20 10.999H22C22 5.869 18.127 2 12.99 2V4C17.052 4 20 6.943 20 10.999Z" fill="white"/>
            <path d="M13 8.00024C15.103 8.00024 16 8.89724 16 11.0002H18C18 7.77524 16.225 6.00024 13 6.00024V8.00024Z" fill="white"/>
            <path d="M16.422 13.443C16.2298 13.2683 15.9773 13.1752 15.7178 13.1832C15.4583 13.1912 15.212 13.2998 15.031 13.486L12.638 15.947C12.062 15.837 10.904 15.476 9.71204 14.287C8.52004 13.094 8.15904 11.933 8.05204 11.361L10.511 8.967C10.6975 8.78612 10.8062 8.53982 10.8142 8.2802C10.8222 8.02059 10.7289 7.768 10.554 7.576L6.85904 3.513C6.68408 3.32071 6.44092 3.2035 6.18119 3.18725C5.92146 3.17101 5.66564 3.25665 5.46804 3.426L3.29804 5.287C3.12515 5.46051 3.0219 5.69145 3.00804 5.937C2.99304 6.186 2.70704 12.108 7.29904 16.702C11.305 20.707 16.323 21 17.705 21C17.907 21 18.031 20.994 18.064 20.992C18.3094 20.9783 18.5402 20.8747 18.713 20.701L20.572 18.53C20.7415 18.3325 20.8273 18.0768 20.8111 17.817C20.7949 17.5573 20.6779 17.3141 20.486 17.139L16.422 13.443Z" fill="white"/>
          </svg>
          <span>TELEFONIA FIXA</span>
        </div>
        
        <h1 class="main-title">
          CONECTE-SE<br/>
          <span class="highlight">SEM LIMITES</span><br/>
          COM QUALIDADE<br/>
          PROFISSIONAL
        </h1>
        
        <p class="description">
          Ligações ilimitadas para todo o Brasil com a melhor qualidade de voz e estabilidade de conexão.
        </p>
        
        <!-- Benefícios -->
        <div class="benefits">
          <div class="benefit-item">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="benefit-text">
              <h3>Portabilidade Grátis</h3>
              <p>Mantenha seu número atual</p>
            </div>
          </div>
          
          <div class="benefit-item">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M13 10V3L4 14H11L11 21L20 10L13 10Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="benefit-text">
              <h3>Ligações Ilimitadas</h3>
              <p>Fixo para fixo em todo Brasil</p>
            </div>
          </div>
          
          <div class="benefit-item">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 12.75L11.25 15L15 9.75M21 12C21 13.1819 20.7672 14.3522 20.3149 15.4442C19.8626 16.5361 19.1997 17.5282 18.364 18.364C17.5282 19.1997 16.5361 19.8626 15.4442 20.3149C14.3522 20.7672 13.1819 21 12 21C10.8181 21 9.64778 20.7672 8.55585 20.3149C7.46392 19.8626 6.47177 19.1997 5.63604 18.364C4.80031 17.5282 4.13738 16.5361 3.68508 15.4442C3.23279 14.3522 3 13.1819 3 12C3 9.61305 3.94821 7.32387 5.63604 5.63604C7.32387 3.94821 9.61305 3 12 3C14.3869 3 16.6761 3.94821 18.364 5.63604C20.0518 7.32387 21 9.61305 21 12Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="benefit-text">
              <h3>Qualidade HD</h3>
              <p>Áudio cristalino e sem ruídos</p>
            </div>
          </div>
        </div>
        
        <!-- CTA Button -->
        <button class="cta-button">
          <span>SOLICITAR AGORA</span>
          <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      
      <!-- Lado direito - Visualização -->
      <div class="visual-section">
        <!-- Telefone moderno com interface digital -->
        <div class="phone-container">
          <!-- Painel digital -->
          <div class="digital-panel">
            <div class="panel-header">
              <div class="status-indicator active"></div>
              <span class="status-text">CONECTADO</span>
              <div class="signal-bars">
                <span class="bar bar-1"></span>
                <span class="bar bar-2"></span>
                <span class="bar bar-3"></span>
                <span class="bar bar-4"></span>
              </div>
            </div>
            
            <div class="display">
              <div class="display-line">
                <svg class="icon-small" viewBox="0 0 24 24" fill="none">
                  <path d="M3 5C3 3.89543 3.89543 3 5 3H8.27924C8.70967 3 9.09181 3.27543 9.22792 3.68377L10.7257 8.17721C10.8831 8.64932 10.6694 9.16531 10.2243 9.38787L7.96701 10.5165C9.06925 12.9612 11.0388 14.9308 13.4835 16.033L14.6121 13.7757C14.8347 13.3306 15.3507 13.1169 15.8228 13.2743L20.3162 14.7721C20.7246 14.9082 21 15.2903 21 15.7208V19C21 20.1046 20.1046 21 19 21H18C9.71573 21 3 14.2843 3 6V5Z" stroke="white" stroke-width="2"/>
                </svg>
                <span class="number-display">0800 123 4567</span>
              </div>
              <div class="call-duration">
                <span class="duration-label">Duração:</span>
                <span class="duration-time">Ilimitado</span>
              </div>
            </div>
            
            <div class="action-buttons">
              <button class="action-btn">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M15.5 5L18 7.5M18 7.5L15.5 10M18 7.5H10C7.79086 7.5 6 9.29086 6 11.5V12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </button>
              <button class="action-btn primary">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M3 5C3 3.89543 3.89543 3 5 3H8.27924C8.70967 3 9.09181 3.27543 9.22792 3.68377L10.7257 8.17721C10.8831 8.64932 10.6694 9.16531 10.2243 9.38787L7.96701 10.5165C9.06925 12.9612 11.0388 14.9308 13.4835 16.033L14.6121 13.7757C14.8347 13.3306 15.3507 13.1169 15.8228 13.2743L20.3162 14.7721C20.7246 14.9082 21 15.2903 21 15.7208V19C21 20.1046 20.1046 21 19 21H18C9.71573 21 3 14.2843 3 6V5Z" stroke="currentColor" stroke-width="2"/>
                </svg>
              </button>
              <button class="action-btn">
                <svg viewBox="0 0 24 24" fill="none">
                  <path d="M19 11H5M19 11C20.1046 11 21 11.8954 21 13V19C21 20.1046 20.1046 21 19 21H5C3.89543 21 3 20.1046 3 19V13C3 11.8954 3.89543 11 5 11M19 11V9C19 7.89543 18.1046 7 17 7M5 11V9C5 7.89543 5.89543 7 7 7M7 7V5C7 3.89543 7.89543 3 9 3H15C16.1046 3 17 3.89543 17 5V7M7 7H17" stroke="currentColor" stroke-width="2"/>
                </svg>
              </button>
            </div>
          </div>
          
          <!-- Ondas de sinal ao redor -->
          <div class="signal-waves">
            <div class="signal-wave wave-1"></div>
            <div class="signal-wave wave-2"></div>
            <div class="signal-wave wave-3"></div>
          </div>
        </div>
        
        <!-- Elementos decorativos -->
        <div class="floating-icons">
          <div class="float-icon icon-1">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="white" stroke-width="2"/>
              <path d="M12 6V12L16 14" stroke="white" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="float-icon icon-2">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="white" stroke-width="2"/>
            </svg>
          </div>
          <div class="float-icon icon-3">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M13 10V3L4 14H11L11 21L20 10L13 10Z" stroke="white" stroke-width="2"/>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .telefonia-banner {
    position: relative;
    width: 100%;
    min-height: 650px;
    overflow: hidden;
  }
  
  .banner-container {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  /* Background com cores Seitel */
  .animated-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgb(0, 151, 178) 0%, rgb(33, 234, 255) 100%);
  }
  
  /* Canvas de conectividade */
  .connectivity-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.08;
  }
  
  /* Container do conteúdo */
  .content-wrapper {
    position: relative;
    display: grid;
    grid-template-columns: 50% 50%;
    gap: 4rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 4rem;
    z-index: 1;
    align-items: center;
  }
  
  /* Seção de informações */
  .info-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    width: fit-content;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }
  
  .badge svg {
    width: 24px;
    height: 24px;
  }
  
  .badge span {
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 1px;
  }
  
  .main-title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.1;
    color: white;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -1px;
  }
  
  .main-title .highlight {
    color: #fff;
    text-shadow: 0 0 40px rgba(255, 255, 255, 0.6);
    display: inline-block;
  }
  
  .description {
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.95);
    line-height: 1.6;
    margin: 0;
  }
  
  /* Benefícios */
  .benefits {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
  }
  
  .benefit-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    padding: 1.25rem 1.5rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }
  
  .benefit-item:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateX(10px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }
  
  .benefit-icon {
    width: 50px;
    height: 50px;
    min-width: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 12px;
  }
  
  .benefit-icon svg {
    width: 28px;
    height: 28px;
  }
  
  .benefit-text h3 {
    color: white;
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  
  .benefit-text p {
    color: rgba(255, 255, 255, 0.9);
    font-size: 0.95rem;
    margin: 0;
  }
  
  /* CTA Button */
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: white;
    color: rgb(0, 151, 178);
    padding: 1.25rem 2.5rem;
    border-radius: 50px;
    border: none;
    font-weight: 700;
    font-size: 1.1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    width: fit-content;
    margin-top: 1rem;
  }
  
  .cta-button svg {
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
  }
  
  .cta-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }
  
  .cta-button:hover svg {
    transform: translateX(5px);
  }
  
  /* Seção visual */
  .visual-section {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
  }
  
  /* Container do telefone */
  .phone-container {
    position: relative;
    animation: floatPhone 4s ease-in-out infinite;
  }
  
  @keyframes floatPhone {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-15px); }
  }
  
  /* Painel digital */
  .digital-panel {
    width: 380px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    padding: 2rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }
  
  .panel-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .status-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #00ff00;
    animation: statusPulse 2s ease-in-out infinite;
  }
  
  @keyframes statusPulse {
    0%, 100% { 
      box-shadow: 0 0 10px #00ff00;
      opacity: 1;
    }
    50% { 
      box-shadow: 0 0 20px #00ff00;
      opacity: 0.7;
    }
  }
  
  .status-text {
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    flex: 1;
  }
  
  .signal-bars {
    display: flex;
    gap: 3px;
    align-items: flex-end;
  }
  
  .bar {
    width: 4px;
    background: white;
    border-radius: 2px;
  }
  
  .bar-1 { height: 8px; }
  .bar-2 { height: 12px; }
  .bar-3 { height: 16px; }
  .bar-4 { height: 20px; animation: barPulse 1.5s ease-in-out infinite; }
  
  @keyframes barPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  
  /* Display */
  .display {
    background: rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }
  
  .display-line {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  
  .icon-small {
    width: 24px;
    height: 24px;
  }
  
  .number-display {
    color: white;
    font-family: monospace;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 2px;
  }
  
  .call-duration {
    display: flex;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }
  
  .duration-label {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
  }
  
  .duration-time {
    color: #00ff00;
    font-weight: 700;
    font-size: 0.9rem;
  }
  
  /* Action buttons */
  .action-buttons {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  
  .action-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .action-btn svg {
    width: 24px;
    height: 24px;
    stroke: white;
  }
  
  .action-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }
  
  .action-btn.primary {
    background: rgba(0, 255, 0, 0.2);
    border-color: rgba(0, 255, 0, 0.5);
  }
  
  .action-btn.primary:hover {
    background: rgba(0, 255, 0, 0.3);
  }
  
  /* Ondas de sinal */
  .signal-waves {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 500px;
    pointer-events: none;
  }
  
  .signal-wave {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    animation: waveExpand 4s ease-out infinite;
  }
  
  .wave-1 {
    width: 100%;
    height: 100%;
    animation-delay: 0s;
  }
  
  .wave-2 {
    width: 100%;
    height: 100%;
    animation-delay: 1.3s;
  }
  
  .wave-3 {
    width: 100%;
    height: 100%;
    animation-delay: 2.6s;
  }
  
  @keyframes waveExpand {
    0% {
      transform: translate(-50%, -50%) scale(0.5);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 0;
    }
  }
  
  /* Ícones flutuantes */
  .floating-icons {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  
  .float-icon {
    position: absolute;
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: floatIcon 6s ease-in-out infinite;
  }
  
  .float-icon svg {
    width: 28px;
    height: 28px;
  }
  
  .icon-1 {
    top: 10%;
    right: 10%;
    animation-delay: 0s;
  }
  
  .icon-2 {
    bottom: 20%;
    right: 5%;
    animation-delay: 2s;
  }
  
  .icon-3 {
    top: 60%;
    left: -5%;
    animation-delay: 4s;
  }
  
  @keyframes floatIcon {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-20px) rotate(10deg);
    }
  }
  
  /* Responsivo */
  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 3rem 2rem;
    }
    
    .main-title {
      font-size: 2.8rem;
    }
    
    .visual-section {
      order: -1;
    }
    
    .floating-icons {
      display: none;
    }
  }
  
  @media (max-width: 768px) {
    .main-title {
      font-size: 2.2rem;
    }
    
    .content-wrapper {
      padding: 2rem 1.5rem;
    }
    
    .digital-panel {
      width: 100%;
      max-width: 380px;
    }
    
    .benefits {
      gap: 1rem;
    }
    
    .benefit-item {
      padding: 1rem;
    }
  }
</style>