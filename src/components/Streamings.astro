---
// Seção de Streaming Apps - Design Moderno
---

<section class="streaming-section-modern">
  <div class="streaming-wrapper">
    
    <!-- Background decorativo -->
    <div class="bg-decorative">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
    </div>
    
    <!-- Padrão de grid sutil -->
    <div class="grid-pattern"></div>
    
    <!-- Conteúdo principal -->
    <div class="streaming-content">
      
      <!-- Cabeçalho -->
      <div class="header-section">
        <h2 class="main-title">
          <span class="title-line-1">Entretenimento</span>
          <span class="title-line-2">Ilimitado</span>
        </h2>
        <p class="subtitle">
          Com a internet de alta velocidade da Seitel, aproveite todos os seus apps de streaming favoritos sem interrupções
        </p>
      </div>
      
      <!-- Container da imagem com efeitos -->
      <div class="image-container-wrapper">
        
        <!-- Efeito de brilho ao redor -->
        <div class="glow-effect"></div>
        
        <!-- Frame da imagem -->
        <div class="image-frame">
          <img 
            src="/images/banapp.png" 
            alt="Aplicativos de Streaming" 
            class="streaming-image"
          />
          
          <!-- Badges flutuantes -->
          <div class="floating-badge badge-left">
            <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <span>4K Ultra HD</span>
          </div>
          
          <div class="floating-badge badge-right">
            <svg class="badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            <span>Zero Lag</span>
          </div>
        </div>
      </div>
      
      <!-- Cards de features -->
      <div class="features-grid-modern">
        
        <!-- Feature 1 -->
        <div class="feature-card-modern">
          <div class="feature-icon-wrapper icon-cyan">
            <svg class="feature-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="feature-title">Velocidade Máxima</h3>
          <p class="feature-text">Internet de fibra óptica para streaming em 4K sem travamentos</p>
        </div>
        
        <!-- Feature 2 -->
        <div class="feature-card-modern">
          <div class="feature-icon-wrapper icon-blue">
            <svg class="feature-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="feature-title">Sem Limite de Dados</h3>
          <p class="feature-text">Assista o quanto quiser sem se preocupar com franquia</p>
        </div>
        
        <!-- Feature 3 -->
        <div class="feature-card-modern">
          <div class="feature-icon-wrapper icon-teal">
            <svg class="feature-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <h3 class="feature-title">Múltiplos Dispositivos</h3>
          <p class="feature-text">Conecte toda a família ao mesmo tempo sem perder qualidade</p>
        </div>
        
      </div>
      
      <!-- CTA Button -->
      <div class="cta-section">
        <a href="/planos-de-internet" class="cta-button-modern">
          <span>Conheça Nossos Planos</span>
          <svg class="arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
      
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=Poppins:wght@300;400;500;600&display=swap');
  
  /* ==================== CONTAINER PRINCIPAL ==================== */
  .streaming-section-modern {
    position: relative;
    width: 100%;
    min-height: 900px;
    background: linear-gradient(135deg, #0a1628 0%, #132f52 50%, #0d2847 100%);
    overflow: hidden;
    padding: 80px 0;
  }
  
  .streaming-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  /* ==================== BACKGROUND DECORATIVO ==================== */
  .bg-decorative {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }
  
  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.15;
    animation: float-orb 20s ease-in-out infinite;
  }
  
  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #00bcd4 0%, transparent 70%);
    top: -200px;
    left: -100px;
  }
  
  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #1fc9e0 0%, transparent 70%);
    bottom: -150px;
    right: -100px;
    animation-delay: 5s;
  }
  
  .orb-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #00a8c5 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: 10s;
  }
  
  @keyframes float-orb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.1); }
    66% { transform: translate(-30px, 30px) scale(0.9); }
  }
  
  /* Grid pattern */
  .grid-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
  }
  
  /* ==================== CONTEÚDO ==================== */
  .streaming-content {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  /* ==================== HEADER ==================== */
  .header-section {
    text-align: center;
    margin-bottom: 60px;
    animation: fade-in-up 0.8s ease-out;
  }
  
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .main-title {
    margin: 0 0 20px 0;
    line-height: 1.1;
  }
  
  .title-line-1,
  .title-line-2 {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(135deg, #ffffff 0%, #00bcd4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.02em;
  }
  
  .title-line-2 {
    background: linear-gradient(135deg, #00bcd4 0%, #1fc9e0 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  
  .subtitle {
    font-family: 'Poppins', sans-serif;
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
    max-width: 800px;
    margin: 0 auto;
    font-weight: 400;
  }
  
  /* ==================== IMAGEM CONTAINER ==================== */
  .image-container-wrapper {
    position: relative;
    max-width: 1200px;
    margin: 0 auto 80px;
    animation: fade-in-up 0.8s ease-out 0.2s backwards;
  }
  
  .glow-effect {
    position: absolute;
    inset: -2px;
    background: linear-gradient(135deg, #00bcd4 0%, #1fc9e0 50%, #00a8c5 100%);
    border-radius: 24px;
    opacity: 0.3;
    filter: blur(20px);
    z-index: 1;
    animation: pulse-glow 3s ease-in-out infinite;
  }
  
  @keyframes pulse-glow {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.5; }
  }
  
  .image-frame {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    padding: 12px;
    border: 1px solid rgba(0, 188, 212, 0.3);
    transition: all 0.4s ease;
  }
  
  .image-frame:hover {
    border-color: rgba(0, 188, 212, 0.6);
    transform: translateY(-5px);
  }
  
  .streaming-image {
    width: 100%;
    height: auto;
    border-radius: 14px;
    display: block;
  }
  
  /* Badges flutuantes */
  .floating-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #00bcd4 0%, #1fc9e0 100%);
    border-radius: 50px;
    font-family: 'Montserrat', sans-serif;
    font-weight: 700;
    font-size: 14px;
    color: white;
    box-shadow: 0 10px 30px rgba(0, 188, 212, 0.4);
    animation: float-badge 3s ease-in-out infinite;
    z-index: 3;
  }
  
  .badge-left {
    top: -20px;
    left: -20px;
  }
  
  .badge-right {
    bottom: -20px;
    right: -20px;
    background: linear-gradient(135deg, #1fc9e0 0%, #00a8c5 100%);
    animation-delay: 1.5s;
  }
  
  @keyframes float-badge {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50% { transform: translateY(-10px) rotate(-7deg); }
  }
  
  .badge-icon {
    width: 20px;
    height: 20px;
    stroke-width: 2.5;
  }
  
  /* ==================== FEATURES GRID ==================== */
  .features-grid-modern {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
  }
  
  .feature-card-modern {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 35px 30px;
    text-align: center;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fade-in-up 0.8s ease-out backwards;
  }
  
  .feature-card-modern:nth-child(1) { animation-delay: 0.3s; }
  .feature-card-modern:nth-child(2) { animation-delay: 0.4s; }
  .feature-card-modern:nth-child(3) { animation-delay: 0.5s; }
  
  .feature-card-modern:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(0, 188, 212, 0.5);
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 188, 212, 0.2);
  }
  
  .feature-icon-wrapper {
    width: 70px;
    height: 70px;
    margin: 0 auto 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.4s ease;
  }
  
  .icon-cyan {
    background: linear-gradient(135deg, #00bcd4 0%, #1fc9e0 100%);
    box-shadow: 0 10px 30px rgba(0, 188, 212, 0.3);
  }
  
  .icon-blue {
    background: linear-gradient(135deg, #1fc9e0 0%, #00a8c5 100%);
    box-shadow: 0 10px 30px rgba(31, 201, 224, 0.3);
  }
  
  .icon-teal {
    background: linear-gradient(135deg, #00a8c5 0%, #00bcd4 100%);
    box-shadow: 0 10px 30px rgba(0, 168, 197, 0.3);
  }
  
  .feature-card-modern:hover .feature-icon-wrapper {
    transform: scale(1.1) rotate(5deg);
  }
  
  .feature-svg {
    width: 35px;
    height: 35px;
    stroke: white;
    stroke-width: 2;
  }
  
  .feature-title {
    font-family: 'Montserrat', sans-serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: white;
    margin: 0 0 12px 0;
  }
  
  .feature-text {
    font-family: 'Poppins', sans-serif;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }
  
  /* ==================== CTA BUTTON ==================== */
  .cta-section {
    text-align: center;
    animation: fade-in-up 0.8s ease-out 0.6s backwards;
  }
  
  .cta-button-modern {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 40px;
    background: linear-gradient(135deg, #00bcd4 0%, #1fc9e0 100%);
    color: white;
    font-family: 'Montserrat', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    border-radius: 50px;
    text-decoration: none;
    box-shadow: 0 10px 40px rgba(0, 188, 212, 0.4);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }
  
  .cta-button-modern::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s ease;
  }
  
  .cta-button-modern:hover::before {
    left: 100%;
  }
  
  .cta-button-modern:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 15px 50px rgba(0, 188, 212, 0.6);
  }
  
  .arrow-icon {
    width: 24px;
    height: 24px;
    stroke-width: 2.5;
    transition: transform 0.3s ease;
  }
  
  .cta-button-modern:hover .arrow-icon {
    transform: translateX(5px);
  }
  
  /* ==================== RESPONSIVIDADE ==================== */
  
  @media (max-width: 1024px) {
    .streaming-section-modern {
      padding: 60px 0;
    }
    
    .streaming-content {
      padding: 0 30px;
    }
    
    .header-section {
      margin-bottom: 50px;
    }
    
    .image-container-wrapper {
      margin-bottom: 60px;
    }
    
    .floating-badge {
      padding: 10px 16px;
      font-size: 12px;
    }
    
    .badge-left {
      top: -15px;
      left: -15px;
    }
    
    .badge-right {
      bottom: -15px;
      right: -15px;
    }
  }
  
  @media (max-width: 768px) {
    .streaming-section-modern {
      padding: 50px 0;
    }
    
    .streaming-content {
      padding: 0 25px;
    }
    
    .title-line-1,
    .title-line-2 {
      font-size: 2.5rem;
    }
    
    .subtitle {
      font-size: 1rem;
    }
    
    .features-grid-modern {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .floating-badge {
      display: none;
    }
    
    .image-frame {
      padding: 8px;
    }
  }
  
  @media (max-width: 480px) {
    .streaming-content {
      padding: 0 20px;
    }
    
    .title-line-1,
    .title-line-2 {
      font-size: 2rem;
    }
    
    .feature-card-modern {
      padding: 25px 20px;
    }
    
    .feature-icon-wrapper {
      width: 60px;
      height: 60px;
    }
    
    .feature-svg {
      width: 30px;
      height: 30px;
    }
    
    .feature-title {
      font-size: 1.2rem;
    }
    
    .cta-button-modern {
      padding: 16px 32px;
      font-size: 1rem;
    }
  }
</style>