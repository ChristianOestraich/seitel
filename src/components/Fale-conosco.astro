---
import Fale from '../assets/Fale.png'
import { Image } from 'astro:assets';
---

<section class="fale-section-modern">
    <!-- Background decorativo moderno -->
    <div class="bg-decorative">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
    </div>
    
    <!-- Imagem de fundo decorativa -->
    <div class="bg-image-overlay">
      <Image 
        src={Fale} 
        alt='Background decorativo' 
        class="background-image"
      />
    </div>
    
    <!-- Padrão de grid sutil -->
    <div class="grid-pattern"></div>

    <!-- Content Container -->
    <div class="fale-content">
        <h2 class="text-white text-center font-bold text-4xl md:text-5xl mb-4">FALE CONOSCO</h2>
        <p class="text-white/80 text-center text-lg mb-12 max-w-2xl mx-auto">
            Entre em contato conosco ou encontre a unidade mais próxima de você
        </p>
        
        <!-- Grid Layout: Form + Locations -->
        <div class="grid lg:grid-cols-2 gap-8 items-start">
            
            <!-- Form Column -->
            <div class="bg-white/95 backdrop-blur-sm rounded-3xl p-8 shadow-2xl border border-white/20">
                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-[#0a3447] mb-2">Envie sua mensagem</h3>
                    <p class="text-gray-600">Preencha o formulário e retornaremos em breve</p>
                </div>
                
                <form class="flex flex-col gap-5" action="">
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="relative">
                            <input 
                                type="text" 
                                placeholder="Nome completo" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        
                        <div class="relative">
                            <input 
                                type="tel" 
                                placeholder="Telefone" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </div>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="relative">
                            <input 
                                type="email" 
                                placeholder="E-mail" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        
                        <div class="relative">
                            <input 
                                type="text" 
                                placeholder="CEP" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                    </div>
                    
                    <div class="relative">
                        <textarea 
                            name="message" 
                            rows="4" 
                            placeholder="Escreva sua mensagem aqui" 
                            class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors resize-none"
                            required
                        ></textarea>
                        <svg class="absolute left-4 top-6 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                    </div>
                    
                    <button 
                        type="submit"
                        class="bg-gradient-to-r from-primary to-secondary p-4 rounded-xl text-white font-bold text-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 group"
                    >
                        <span>Enviar mensagem</span>
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Locations Column -->
            <div class="bg-white/95 backdrop-blur-sm rounded-3xl p-6 shadow-2xl border border-white/20">
                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-[#0a3447] mb-2">Nossas unidades</h3>
                    <p class="text-gray-600">Encontre a unidade Seitel mais próxima de você</p>
                </div>

                <!-- Location Cards -->
                <div class="space-y-4">
                    <!-- Location 1 - Rod. Aleixo Rocha da Silva -->
