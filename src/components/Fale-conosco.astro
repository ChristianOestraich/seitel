---
import Fale from '../assets/Fale.png'
import { Image } from 'astro:assets';
---

<section class="relative px-[5%] py-20 min-h-[800px] flex items-center justify-center overflow-hidden">
    <!-- Background image -->
    <div class="absolute inset-0 z-0">
        <Image 
            src={Fale} 
            alt='Background - fale conosco' 
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-[#0a3447]/70"></div>
    </div>

    <!-- Decorative elements -->
    <div class="absolute inset-0 z-[1] pointer-events-none">
        <div class="absolute top-10 left-10 w-32 h-32 bg-primary/10 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-20 w-40 h-40 bg-secondary/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Content Container -->
    <div class="relative z-10 w-full max-w-7xl mx-auto">
        <h2 class="text-white text-center font-bold text-4xl md:text-5xl mb-4">FALE CONOSCO</h2>
        <p class="text-white/80 text-center text-lg mb-12 max-w-2xl mx-auto">
            Entre em contato conosco ou encontre a unidade mais próxima de você
        </p>
        
        <!-- Grid Layout: Form + Locations -->
        <div class="grid lg:grid-cols-2 gap-8 items-start">
            
            <!-- Form Column -->
            <div class="bg-white/95 backdrop-blur-sm rounded-3xl p-8 shadow-2xl border border-white/20">
                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-[#0a3447] mb-2">Envie sua mensagem</h3>
                    <p class="text-gray-600">Preencha o formulário e retornaremos em breve</p>
                </div>
                
                <form class="flex flex-col gap-5" action="">
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="relative">
                            <input 
                                type="text" 
                                placeholder="Nome completo" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        
                        <div class="relative">
                            <input 
                                type="tel" 
                                placeholder="Telefone" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </div>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="relative">
                            <input 
                                type="email" 
                                placeholder="E-mail" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        
                        <div class="relative">
                            <input 
                                type="text" 
                                placeholder="CEP" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                    </div>
                    
                    <div class="relative">
                        <textarea 
                            name="message" 
                            rows="4" 
                            placeholder="Escreva sua mensagem aqui" 
                            class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors resize-none"
                            required
                        ></textarea>
                        <svg class="absolute left-4 top-6 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                    </div>
                    
                    <button 
                        type="submit"
                        class="bg-gradient-to-r from-primary to-secondary p-4 rounded-xl text-white font-bold text-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 group"
                    >
                        <span>Enviar mensagem</span>
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Locations Column -->
            <div class="bg-white/95 backdrop-blur-sm rounded-3xl p-6 shadow-2xl border border-white/20">
                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-[#0a3447] mb-2">Nossas unidades</h3>
                    <p class="text-gray-600">Encontre a unidade Seitel mais próxima de você</p>
                </div>

                <!-- Location Cards -->
                <div class="space-y-4">
                    <!-- Location 1 - Rod. Aleixo Rocha da Silva -->
                    <div class="group p-5 bg-gradient-to-br from-primary/5 via-primary/3 to-transparent rounded-2xl border-2 border-primary/20 hover:border-primary/40 hover:shadow-lg transition-all duration-300 cursor-pointer">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-gradient-to-br from-primary to-secondary rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg">
                                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-[#0a3447] text-lg mb-2">Seitel Taquari - Unidade 1</h4>
                                <div class="space-y-1.5 text-gray-600">
                                    <p class="flex items-start gap-2">
                                        <svg class="w-4 h-4 mt-0.5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-sm">Rod. Aleixo Rocha da Silva, 871<br>Léo Alvim Faller, Taquari - RS<br>CEP: 95860-000</span>
                                    </p>
                                    <p class="flex items-center gap-2 pt-2">
                                        <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                                        </svg>
                                        <span class="text-sm font-semibold text-primary">(51) 3653-3200</span>
                                    </p>
                                </div>
                                <a 
                                    href="https://www.google.com/maps/search/?api=1&query=-29.7219,-51.8237" 
                                    target="_blank"
                                    class="inline-flex items-center gap-2 mt-3 text-sm text-primary hover:text-secondary font-medium transition-colors"
                                >
                                    <span>Ver no Google Maps</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Location 2 - Centro de Taquari -->
                    <div class="group p-5 bg-gradient-to-br from-secondary/5 via-secondary/3 to-transparent rounded-2xl border-2 border-secondary/20 hover:border-secondary/40 hover:shadow-lg transition-all duration-300 cursor-pointer">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-gradient-to-br from-secondary to-primary rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg">
                                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-[#0a3447] text-lg mb-2">Seitel Taquari - Centro</h4>
                                <div class="space-y-1.5 text-gray-600">
                                    <p class="flex items-start gap-2">
                                        <svg class="w-4 h-4 mt-0.5 text-secondary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-sm">Rua Sete de Setembro, 2130<br>Centro, Taquari - RS<br>CEP: 95860-000</span>
                                    </p>
                                    <p class="flex items-center gap-2 pt-2">
                                        <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                                        </svg>
                                        <span class="text-sm font-semibold text-secondary">(51) 3653-3200</span>
                                    </p>
                                </div>
                                <a 
                                    href="https://www.google.com/maps/search/?api=1&query=-29.8006,-51.8638" 
                                    target="_blank"
                                    class="inline-flex items-center gap-2 mt-3 text-sm text-secondary hover:text-primary font-medium transition-colors"
                                >
                                    <span>Ver no Google Maps</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>

                    <!-- Location 3 - Triunfo -->
                    <div class="group p-5 bg-gradient-to-br from-primary/5 via-primary/3 to-transparent rounded-2xl border-2 border-primary/20 hover:border-primary/40 hover:shadow-lg transition-all duration-300 cursor-pointer">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-gradient-to-br from-primary to-secondary rounded-xl flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300 shadow-lg">
                                <svg class="w-7 h-7 text-white" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                </svg>
                            </div>
                            <div class="flex-1">
                                <h4 class="font-bold text-[#0a3447] text-lg mb-2">Seitel Triunfo</h4>
                                <div class="space-y-1.5 text-gray-600">
                                    <p class="flex items-start gap-2">
                                        <svg class="w-4 h-4 mt-0.5 text-primary flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                        </svg>
                                        <span class="text-sm">Avenida Luiz Barreto, 119<br>Centro, Triunfo - RS<br>CEP: 95840-000</span>
                                    </p>
                                    <p class="flex items-center gap-2 pt-2">
                                        <svg class="w-4 h-4 text-primary" fill="currentColor" viewBox="0 0 20 20">
                                            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                                        </svg>
                                        <span class="text-sm font-semibold text-primary">(51) 3653-3200</span>
                                    </p>
                                </div>
                                <a 
                                    href="https://www.google.com/maps/search/?api=1&query=-29.9296,-51.7192" 
                                    target="_blank"
                                    class="inline-flex items-center gap-2 mt-3 text-sm text-primary hover:text-secondary font-medium transition-colors"
                                >
                                    <span>Ver no Google Maps</span>
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* Location card animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive adjustments */
    @media (max-width: 1024px) {
        .lg\:sticky {
            position: static !important;
        }
    }
</style>