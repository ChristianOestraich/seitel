<style>
  /* ==================== SEÇÃO PRINCIPAL ==================== */
  .fale-section-modern {
    position: relative;
    width: 100%;
    min-height: 900px;
    background: linear-gradient(135deg, #0a1628 0%, #132f52 50%, #0d2847 100%);
    overflow: hidden;
    padding: 80px 0;
  }
  
  /* ==================== BACKGROUND DECORATIVO ==================== */
  .bg-decorative {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }
  
  /* ==================== IMAGEM DE FUNDO DECORATIVA ==================== */
  .bg-image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }
  
  .background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.15;
    mix-blend-mode: soft-light;
    filter: brightness(1.2) contrast(0.9);
  }
  
  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.15;
    animation: float-orb 20s ease-in-out infinite;
  }
  
  .orb-1 {
