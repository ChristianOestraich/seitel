---

<section class="fale-section-modern">
    <!-- Background decorativo moderno -->
    <div class="bg-decorative">
      <div class="gradient-orb orb-1"></div>
      <div class="gradient-orb orb-2"></div>
      <div class="gradient-orb orb-3"></div>
    </div>
    
    <!-- Imagem de fundo decorativa -->
    <div class="bg-image-overlay">
      <Image 
        src={Fale} 
        alt='Background decorativo' 
        class="background-image"
      />
    </div>
    
    <!-- Padrão de grid sutil -->
    <div class="grid-pattern"></div>

    <!-- Content Container -->
    <div class="fale-content">
        <h2 class="text-white text-center font-bold text-4xl md:text-5xl mb-4">FALE CONOSCO</h2>
        <p class="text-white/80 text-center text-lg mb-12 max-w-2xl mx-auto">
            Entre em contato conosco ou encontre a unidade mais próxima de você
        </p>
        
        <!-- Grid Layout: Form + Locations -->
        <div class="grid lg:grid-cols-2 gap-8 items-start">
            
            <!-- Form Column -->
            <div class="bg-white/95 backdrop-blur-sm rounded-3xl p-8 shadow-2xl border border-white/20">
                <div class="mb-6">
                    <h3 class="text-2xl font-bold text-[#0a3447] mb-2">Envie sua mensagem</h3>
                    <p class="text-gray-600">Preencha o formulário e retornaremos em breve</p>
                </div>
                
                <form class="flex flex-col gap-5" id="contactForm">
                    <!-- Web3Forms Access Key -->
                    <input type="hidden" name="access_key" value="0ab5c8a9-da8e-4515-9f7e-f1e9853d3b30" />
                    <input type="hidden" name="subject" value="Nova Mensagem - Seitel Fale Conosco" />

                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="relative">
                            <input 
                                type="text"
                                name="nome"
                                placeholder="Nome completo" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        
                        <div class="relative">
                            <input 
                                type="tel"
                                name="telefone"
                                id="phone"
                                placeholder="Telefone" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                            </svg>
                        </div>
                    </div>
                    
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="relative">
                            <input 
                                type="email"
                                name="email"
                                placeholder="E-mail" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                                required
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                        </div>
                        
                        <div class="relative">
                            <input 
                                type="text"
                                name="cep"
                                id="cep"
                                placeholder="CEP" 
                                class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors"
                            />
                            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                        </div>
                    </div>
                    
                    <div class="relative">
                        <textarea 
                            name="message" 
                            rows="4" 
                            placeholder="Escreva sua mensagem aqui" 
                            class="w-full p-4 pl-12 rounded-xl border-2 border-gray-200 focus:border-primary focus:outline-none transition-colors resize-none"
                            required
                        ></textarea>
                        <svg class="absolute left-4 top-6 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                    </div>
                    
                    <button 
                        id="submitBtn"
                        type="submit"
                        class="submit-button bg-gradient-to-r from-primary to-secondary p-4 rounded-xl text-white font-bold text-lg hover:shadow-xl hover:scale-[1.02] active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-2 group"
                    >
                        <span class="button-text">Enviar mensagem</span>
                        <span class="button-loading" style="display:none;">
                            <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            Enviando...
                        </span>
                        <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform button-text" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                        </svg>
                    </button>

                    <!-- Success Message -->
                    <div id="successMessage" class="hidden bg-green-50 border-2 border-green-200 rounded-xl p-5 flex items-start gap-4">
                        <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center flex-shrink-0">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                        </div>
                        <div>
                            <h4 class="font-bold text-green-800 text-lg mb-1">Mensagem enviada com sucesso!</h4>
                            <p class="text-green-700 text-sm">Obrigado pelo contato! Retornaremos em breve.</p>
                        </div>
                    </div>
                </form>
            </div>

            <!-- Locations Column -->
            <div class="bg-white/95 backdrop-blur-sm rounded-3xl p-6 shadow-2xl border border-white/20">
                <div class="mb-6 flex items-center justify-between">
                    <div>
                        <h3 class="text-2xl font-bold text-[#0a3447] mb-2">Nossas unidades</h3>
                        <p class="text-gray-600">Encontre a unidade Seitel mais próxima de você</p>
                    </div>
                </div>

                <!-- Location Cards Container com Scroll Vertical Limpos -->
                <div class="locations-scroll-container max-h-[520px] overflow-y-auto pr-2 flex flex-col gap-4">
                    {locacoes.map((locacao) => (
                        <div class="group w-full p-5 bg-slate-50/80 rounded-2xl border-2 border-sky-100 hover:border-sky-300 hover:shadow-md transition-all duration-300">
                            <div class="flex items-start gap-4">
                                <!-- Ícone do Mapa -->
                                <div class="w-12 h-12 bg-sky-500 rounded-xl flex items-center justify-center flex-shrink-0 shadow-sm">
                                    <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                    </svg>
                                </div>

                                <!-- Conteúdo do Card -->
                                <div class="flex-1">
                                    <h4 class="font-bold text-[#0a3447] text-lg mb-2">{locacao.nome}</h4>
                                    
                                    <div class="space-y-2 text-gray-600">
                                        <!-- Endereço -->
                                        <p class="flex items-start gap-2">
                                            <svg class="w-4 h-4 mt-1 text-sky-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                                            </svg>
                                            <span class="text-sm">
                                                {locacao.endereco}<br>
                                                {locacao.bairro}, {locacao.cidade} - {locacao.estado}<br>
                                                CEP: {locacao.cep}
                                            </span>
                                        </p>

                                        <!-- Telefone Fixo -->
                                        <p class="flex items-center gap-2">
                                            <svg class="w-4 h-4 text-gray-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z" />
                                            </svg>
                                            <span class="text-sm font-semibold text-gray-800">{locacao.telefone}</span>
                                        </p>

                                        <!-- WhatsApp -->
                                        <a 
                                            href={`https://wa.me/55${locacao.whatsapp.replace(/\D/g, '')}`}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="flex items-center gap-2 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors"
                                        >
                                            <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                                            </svg>
                                            <span>{locacao.whatsapp}</span>
                                        </a>
                                    </div>

                                    <!-- Link Google Maps -->
                                    <a 
                                        href={locacao.googleMapsUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-1.5 mt-3 text-sm text-sky-600 hover:text-sky-700 font-medium transition-colors"
                                    >
                                        <span>Ver no Google Maps</span>
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<style>
  .fale-section-modern {
    position: relative;
    width: 100%;
    min-height: 900px;
    background: linear-gradient(135deg, #0a1628 0%, #132f52 50%, #0d2847 100%);
    overflow: hidden;
    padding: 80px 0;
  }
  
  .bg-decorative {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }
  
  .bg-image-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }
  
  .background-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.15;
    mix-blend-mode: soft-light;
    filter: brightness(1.2) contrast(0.9);
  }
  
  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.15;
    animation: float-orb 20s ease-in-out infinite;
  }
  
  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #00bcd4 0%, transparent 70%);
    top: -200px;
    left: -100px;
  }
  
  .orb-2 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, #1fc9e0 0%, transparent 70%);
    bottom: -150px;
    right: -100px;
    animation-delay: 5s;
  }
  
  .orb-3 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #00a8c5 0%, transparent 70%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: 10s;
  }
  
  @keyframes float-orb {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(30px, -30px) scale(1.1); }
    66% { transform: translate(-30px, 30px) scale(0.9); }
  }
  
  .grid-pattern {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 2;
  }
  
  .fale-content {
    position: relative;
    z-index: 10;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }
  
  @media (max-width: 1024px) {
    .fale-section-modern { padding: 60px 0; }
    .fale-content { padding: 0 30px; }
  }
  
  @media (max-width: 768px) {
    .fale-section-modern { padding: 50px 0; }
    .fale-content { padding: 0 25px; }
  }
  
  @media (max-width: 480px) {
    .fale-content { padding: 0 20px; }
  }

    /* Scroll Vertical Customizado */
    .locations-scroll-container {
    scrollbar-width: thin;
    scrollbar-color: #0ea5e9 #f1f5f9;
    }

    .locations-scroll-container::-webkit-scrollbar {
    width: 6px;
    }

    .locations-scroll-container::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 10px;
    }

    .locations-scroll-container::-webkit-scrollbar-thumb {
    background: #0ea5e9;
    border-radius: 10px;
    }

    .locations-scroll-container::-webkit-scrollbar-thumb:hover {
    background: #0284c7;
    }

  /* Firefox */
  .locations-scroll-container {
    scrollbar-color: #1fc9e0 rgba(31, 201, 224, 0.1);
    scrollbar-width: thin;
  }

  /* Indicador de scroll (mobile) */
  @media (max-width: 768px) {
    .locations-scroll-container {
      -webkit-mask-image: linear-gradient(to right, black 85%, transparent);
      mask-image: linear-gradient(to right, black 85%, transparent);
    }
  }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('contactForm');
        const submitBtn = document.getElementById('submitBtn');
        const buttonText = submitBtn.querySelectorAll('.button-text');
        const buttonLoading = submitBtn.querySelector('.button-loading');
        const successMessage = document.getElementById('successMessage');

        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            buttonText.forEach(el => el.style.display = 'none');
            buttonLoading.style.display = 'inline-flex';
            submitBtn.disabled = true;

            try {
                const formData = new FormData(form);
                const object = Object.fromEntries(formData);
                const json = JSON.stringify(object);

                const response = await fetch('https://api.web3forms.com/submit', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: json
                });

                const result = await response.json();

                if (result.success) {
                    successMessage.classList.remove('hidden');
                    form.reset();
                    successMessage.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    setTimeout(() => successMessage.classList.add('hidden'), 10000);
                } else {
                    alert('Erro ao enviar. Tente novamente.');
                }
            } catch (err) {
                alert('Erro de conexão. Tente novamente.');
            } finally {
                buttonText.forEach(el => el.style.display = 'inline');
                buttonLoading.style.display = 'none';
                submitBtn.disabled = false;
            }
        });

        // Máscara telefone
        const phoneInput = document.getElementById('phone');
        if (phoneInput) {
            phoneInput.addEventListener('input', (e) => {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length <= 11) {
                    value = value.replace(/^(\d{2})(\d)/g, '($1) $2');
                    value = value.replace(/(\d)(\d{4})$/, '$1-$2');
                }
                e.target.value = value;
            });
        }

        // Máscara CEP
        const cepInput = document.getElementById('cep');
        if (cepInput) {
            cepInput.addEventListener('input', (e) => {
                let value = e.target.value.replace(/\D/g, '');
                if (value.length <= 8) {
                    value = value.replace(/(\d{5})(\d)/, '$1-$2');
                }
                e.target.value = value;
            });
        }
    });
</script>