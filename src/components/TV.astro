---
// Banner de Conectividade de Alta Performance
---

<section class="connectivity-banner">
  <div class="banner-container">
    <!-- Background com gradiente animado -->
    <div class="animated-bg"></div>
    
    <!-- Grid de pontos/linhas animadas -->
    <canvas id="networkCanvas" class="network-canvas"></canvas>
    
    <!-- Conteúdo principal -->
    <div class="content-wrapper">
      <!-- Lado esquerdo - Laptop -->
      <div class="laptop-section">
        <div class="laptop-container">
          <!-- Linhas de velocidade -->
          <div class="speed-lines">
            <div class="speed-line"></div>
            <div class="speed-line"></div>
            <div class="speed-line"></div>
          </div>
          
          <!-- Tela do Laptop -->
          <div class="laptop-screen">
            <div class="screen-content">
              <div class="screen-glare"></div>
              
              <!-- Ícone WiFi -->
              <div class="wifi-icon">
                <span></span>
                <span></span>
                <span></span>
              </div>
              
              <!-- Texto na tela -->
              <h2>CONEXÃO<br/>DE ALTA<br/>PERFORMANCE</h2>
            </div>
          </div>
          
          <!-- Base do Laptop -->
          <div class="laptop-base"></div>
        </div>
      </div>
      
      <!-- Lado direito - Título e Features -->
      <div class="features-section">
        <h1 class="main-title">
          <span class="title-highlight">Conectividade de alta performance:</span>
          <span class="title-normal">Descubra a diferença!</span>
        </h1>
        
        <!-- Grid de features -->
        <div class="features-grid">
          <!-- Feature 1 - Cloud -->
          <div class="feature-card" data-index="0">
            <div class="feature-icon cloud-icon">
              <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M52 38C54.7614 38 57 35.7614 57 33C57 30.2386 54.7614 28 52 28C51.8965 28 51.7938 28.0034 51.692 28.01C51.2354 23.0666 47.0666 19.25 42 19.25C38.9654 19.25 36.2324 20.6904 34.4648 22.9258C33.384 22.3428 32.1504 22 30.8333 22C26.7793 22 23.5 25.2793 23.5 29.3333C23.5 29.6367 23.5195 29.9355 23.5576 30.2285C20.5547 30.8193 18.25 33.5146 18.25 36.75C18.25 40.4779 21.2721 43.5 25 43.5H52Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M32 36V48M32 48L28 44M32 48L36 44" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <p class="feature-text">Baixe arquivos em segundos, assista a vídeos sem travamentos e aproveite uma navegação contínua, pensada para não interromper seu dia.</p>
          </div>
          
          <!-- Feature 2 - Security -->
          <div class="feature-card" data-index="1">
            <div class="feature-icon security-icon">
              <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M32 12L18 18V28C18 38.5 24 46 32 50C40 46 46 38.5 46 28V18L32 12Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M27 32L30 35L37 28" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <p class="feature-text">Nossa conexão é desenvolvida com foco em proteção digital, utilizando recursos avançados contra ameaças online para manter seus dados sempre protegidos.</p>
          </div>
          
          <!-- Feature 3 - WiFi -->
          <div class="feature-card" data-index="2">
            <div class="feature-icon wifi-icon">
              <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M16 26C21.1826 21.3333 27.5913 19 32 19C36.4087 19 42.8174 21.3333 48 26" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M22 33C25.2044 30.3333 28.6022 29 32 29C35.3978 29 38.7956 30.3333 42 33" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="32" cy="42" r="3" fill="white"/>
              </svg>
            </div>
            <p class="feature-text">Ideal para videochamadas, trabalho remoto e entretenimento, nossa internet entrega desempenho constante e confiança em cada acesso.</p>
          </div>
          
          <!-- Feature 4 - Support -->
          <div class="feature-card" data-index="3">
            <div class="feature-icon support-icon">
              <svg viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="32" cy="32" r="16" stroke="white" stroke-width="2.5"/>
                <path d="M24 28C24 28 26 24 32 24C38 24 40 28 40 28" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                <path d="M24 36H22C20.8954 36 20 36.8954 20 38V40C20 41.1046 20.8954 42 22 42H24V36Z" stroke="white" stroke-width="2.5"/>
                <path d="M40 36H42C43.1046 36 44 36.8954 44 38V40C44 41.1046 43.1046 42 42 42H40V36Z" stroke="white" stroke-width="2.5"/>
              </svg>
            </div>
            <p class="feature-text">Atendimento 24 horas por dia, com uma equipe preparada para resolver rapidamente e oferecer soluções sob medida, sem dor de cabeça.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .connectivity-banner {
    position: relative;
    width: 100%;
    min-height: 600px;
    overflow: hidden;
  }
  
  .banner-container {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  /* Background animado */
  .animated-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #00d4ff 0%, #00a8e8 50%, #0099d9 100%);
    background-size: 200% 200%;
    animation: gradientShift 8s ease infinite;
  }
  
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  
  /* Canvas de rede */
  .network-canvas {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.15;
  }
  
  /* Container do conteúdo */
  .content-wrapper {
    position: relative;
    display: grid;
    grid-template-columns: 40% 60%;
    gap: 2rem;
    max-width: 1400px;
    margin: 0 auto;
    padding: 3rem 4rem;
    z-index: 1;
  }
  
  /* Seção do Laptop */
  .laptop-section {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .laptop-container {
    position: relative;
    width: 100%;
    max-width: 400px;
    animation: float 6s ease-in-out infinite;
    transform-style: preserve-3d;
  }
  
  @keyframes float {
    0%, 100% { 
      transform: translateY(0px) perspective(1000px) rotateY(-25deg) rotateX(5deg); 
    }
    50% { 
      transform: translateY(-20px) perspective(1000px) rotateY(-25deg) rotateX(5deg); 
    }
  }
  
  /* Linhas de velocidade */
  .speed-lines {
    position: absolute;
    left: -80px;
    top: 50%;
    transform: translateY(-50%);
    width: 128px;
    height: 100%;
    pointer-events: none;
  }
  
  .speed-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.4), transparent);
    border-radius: 9999px;
    animation: speedLines 2s ease-in-out infinite;
  }
  
  .speed-line:nth-child(1) {
    top: 30%;
    animation-delay: 0s;
  }
  
  .speed-line:nth-child(2) {
    top: 50%;
    animation-delay: 0.3s;
  }
  
  .speed-line:nth-child(3) {
    top: 70%;
    animation-delay: 0.6s;
  }
  
  @keyframes speedLines {
    0% { 
      transform: translateX(-100%) scaleX(0); 
      opacity: 0; 
    }
    50% { 
      opacity: 1; 
    }
    100% { 
      transform: translateX(200%) scaleX(1); 
      opacity: 0; 
    }
  }
  
  /* Tela do Laptop */
  .laptop-screen {
    background: linear-gradient(135deg, #2a2a2a 0%, #1a1a1a 100%);
    border-radius: 12px 12px 0 0;
    padding: 1rem;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
    border: 3px solid #333;
  }
  
  .screen-content {
    background: linear-gradient(135deg, #1a1a1a 0%, #0a0a0a 100%);
    border-radius: 8px;
    padding: 3rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  
  .screen-glare {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    animation: screenGlare 3s infinite;
  }
  
  @keyframes screenGlare {
    0% { left: -100%; }
    100% { left: 100%; }
  }
  
  /* Ícone WiFi */
  .wifi-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 1.5rem;
  }
  
  .wifi-icon span {
    width: 50px;
    height: 8px;
    background: #00d4ff;
    border-radius: 4px;
    animation: wifiPulse 1.5s ease-in-out infinite;
  }
  
  .wifi-icon span:nth-child(1) {
    width: 30px;
    animation-delay: 0s;
  }
  
  .wifi-icon span:nth-child(2) {
    width: 40px;
    animation-delay: 0.2s;
  }
  
  .wifi-icon span:nth-child(3) {
    animation-delay: 0.4s;
  }
  
  @keyframes wifiPulse {
    0%, 100% { opacity: 0.4; transform: scaleX(0.9); }
    50% { opacity: 1; transform: scaleX(1); }
  }
  
  .screen-content h2 {
    color: #00d4ff;
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.2;
    text-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
  }
  
  /* Base do Laptop */
  .laptop-base {
    width: 110%;
    height: 20px;
    background: linear-gradient(135deg, #444 0%, #2a2a2a 100%);
    border-radius: 0 0 20px 20px;
    margin: 0 -5%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }
  
  /* Seção de Features */
  .features-section {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  
  .main-title {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }
  
  .title-highlight {
    display: block;
    color: white;
    font-weight: 800;
  }
  
  .title-normal {
    display: block;
    color: white;
  }
  
  /* Grid de Features */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }
  
  .feature-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: all 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.2);
    animation: fadeInUp 0.6s ease forwards;
    opacity: 0;
  }
  
  .feature-card[data-index="0"] { animation-delay: 0.1s; }
  .feature-card[data-index="1"] { animation-delay: 0.2s; }
  .feature-card[data-index="2"] { animation-delay: 0.3s; }
  .feature-card[data-index="3"] { animation-delay: 0.4s; }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .feature-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.25);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }
  
  .feature-icon {
    width: 60px;
    height: 60px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }
  
  .feature-icon svg {
    width: 32px;
    height: 32px;
  }
  
  .feature-card:hover .feature-icon {
    transform: scale(1.1) rotate(5deg);
    background: rgba(255, 255, 255, 0.3);
  }
  
  .feature-text {
    color: white;
    font-size: 0.95rem;
    line-height: 1.5;
    margin: 0;
  }
  
  /* Responsivo */
  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 2rem 3rem;
    }
    
    .laptop-container {
      max-width: 350px;
    }
    
    .main-title {
      font-size: 2rem;
    }
    
    .speed-lines {
      display: none;
    }
  }
  
  @media (max-width: 768px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    
    .main-title {
      font-size: 1.8rem;
    }
    
    .content-wrapper {
      padding: 2rem 1.5rem;
    }
    
    .laptop-container {
      max-width: 300px;
    }
  }
</style>

<script>
  // Animação de rede neural no canvas
  const canvas = document.getElementById('networkCanvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  
  function resizeCanvas() {
    canvas.width = canvas.offsetWidth;
    canvas.height = canvas.offsetHeight;
  }
  
  resizeCanvas();
  window.addEventListener('resize', resizeCanvas);
  
  class Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    
    constructor() {
      this.x = Math.random() * canvas.width;
      this.y = Math.random() * canvas.height;
      this.vx = (Math.random() - 0.5) * 0.5;
      this.vy = (Math.random() - 0.5) * 0.5;
    }
    
    update() {
      this.x += this.vx;
      this.y += this.vy;
      
      if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
      if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
    }
    
    draw() {
      ctx.beginPath();
      ctx.arc(this.x, this.y, 2, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.5)';
      ctx.fill();
    }
  }
  
  const particles: Particle[] = [];
  const particleCount = 50;
  
  for (let i = 0; i < particleCount; i++) {
    particles.push(new Particle());
  }
  
  function animate() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    
    particles.forEach(particle => {
      particle.update();
      particle.draw();
    });
    
    // Conectar partículas próximas
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const distance = Math.sqrt(dx * dx + dy * dy);
        
        if (distance < 150) {
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = `rgba(255, 255, 255, ${0.2 * (1 - distance / 150)})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
      }
    }
    
    requestAnimationFrame(animate);
  }
  
  animate();
</script>