---
// Banner de Conectividade - Réplica Exata da Imagem Original
---

<section class="connectivity-banner-original">
  <div class="banner-container-wrapper">
    
    <!-- Background com padrão de rede e linhas conectadas -->
    <div class="network-layer">
      <svg class="network-svg-bg" viewBox="0 0 1600 600" preserveAspectRatio="none">
        <!-- Grid diagonal -->
        <defs>
          <pattern id="diagonal-grid" width="60" height="60" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <line x1="0" y1="0" x2="60" y2="0" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
            <line x1="0" y1="0" x2="0" y2="60" stroke="rgba(255,255,255,0.08)" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#diagonal-grid)"/>
        
        <!-- Pontos flutuantes conectados - ESQUERDA -->
        <circle cx="8%" cy="12%" r="5" fill="rgba(255,255,255,0.35)">
          <animate attributeName="opacity" values="0.35;0.65;0.35" dur="3s" repeatCount="indefinite"/>
        </circle>
        <circle cx="12%" cy="28%" r="5" fill="rgba(255,255,255,0.35)">
          <animate attributeName="opacity" values="0.35;0.65;0.35" dur="3.5s" repeatCount="indefinite"/>
        </circle>
        <circle cx="7%" cy="48%" r="5" fill="rgba(255,255,255,0.35)">
          <animate attributeName="opacity" values="0.35;0.65;0.35" dur="4s" repeatCount="indefinite"/>
        </circle>
        <circle cx="15%" cy="68%" r="5" fill="rgba(255,255,255,0.35)">
          <animate attributeName="opacity" values="0.35;0.65;0.35" dur="3.8s" repeatCount="indefinite"/>
        </circle>
        
        <!-- Linhas conectando pontos - ESQUERDA -->
        <line x1="8%" y1="12%" x2="12%" y2="28%" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
        <line x1="12%" y1="28%" x2="7%" y2="48%" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
        <line x1="7%" y1="48%" x2="15%" y2="68%" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
        
        <!-- Pontos flutuantes - DIREITA/CENTRO -->
        <circle cx="88%" cy="18%" r="5" fill="rgba(255,255,255,0.35)">
          <animate attributeName="opacity" values="0.35;0.65;0.35" dur="3.2s" repeatCount="indefinite"/>
        </circle>
        <circle cx="82%" cy="38%" r="5" fill="rgba(255,255,255,0.35)">
          <animate attributeName="opacity" values="0.35;0.65;0.35" dur="3.7s" repeatCount="indefinite"/>
        </circle>
        <circle cx="92%" cy="55%" r="5" fill="rgba(255,255,255,0.35)">
          <animate attributeName="opacity" values="0.35;0.65;0.35" dur="4.2s" repeatCount="indefinite"/>
        </circle>
        
        <!-- Linhas conectando - DIREITA -->
        <line x1="88%" y1="18%" x2="82%" y2="38%" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
        <line x1="82%" y1="38%" x2="92%" y2="55%" stroke="rgba(255,255,255,0.18)" stroke-width="1.5"/>
      </svg>
    </div>
    
    <!-- Curvas decorativas superior direita -->
    <div class="top-right-curves">
      <svg viewBox="0 0 600 250" preserveAspectRatio="none">
        <path d="M 600,0 Q 450,50 400,100 Q 350,150 300,200 L 300,250 L 600,250 Z" 
              fill="none" 
              stroke="rgba(255,255,255,0.25)" 
              stroke-width="3"/>
        <path d="M 600,0 Q 470,60 420,120 Q 370,170 320,220 L 320,250 L 600,250 Z" 
              fill="none" 
              stroke="rgba(255,255,255,0.2)" 
              stroke-width="3"/>
        <path d="M 600,0 Q 490,70 440,140 Q 390,190 340,240 L 340,250 L 600,250 Z" 
              fill="none" 
              stroke="rgba(255,255,255,0.15)" 
              stroke-width="2"/>
      </svg>
    </div>
    
    <!-- Ondas decorativas inferior -->
    <div class="bottom-waves">
      <svg viewBox="0 0 1600 150" preserveAspectRatio="none">
        <path d="M 0,80 Q 200,40 400,80 T 800,80 T 1200,80 T 1600,80 L 1600,150 L 0,150 Z" 
              fill="rgba(255,255,255,0.12)"/>
        <path d="M 0,100 Q 250,65 500,100 T 1000,100 T 1600,100 L 1600,150 L 0,150 Z" 
              fill="rgba(255,255,255,0.08)"/>
      </svg>
    </div>
    
    <!-- Efeito de tira decorativa esquerda -->
    <div class="side-strip left-strip">
      <img src="/images/efeitoTira.png" alt="" class="strip-image"/>
    </div>
    
    <!-- Efeito de tira decorativa direita -->
    <div class="side-strip right-strip">
      <img src="/images/efeitoTira.png" alt="" class="strip-image"/>
    </div>
    
    <!-- CONTEÚDO PRINCIPAL -->
    <div class="content-main-grid">
      
      <!-- LADO ESQUERDO: Cadu + Título -->
      <div class="left-content-area">
        
        <!-- Container do Cadu com Foguete -->
        <div class="cadu-rocket-wrapper">
          <img src="/images/Cadu.png" alt="Cadu no Foguete" class="cadu-mascot-image"/>
        </div>
        
        <!-- Título Grande -->
        <div class="title-main-block">
          <h1 class="main-heading">
            <span class="heading-line">Conectividade de</span>
            <span class="heading-line">alta performance:</span>
            <span class="heading-line-light">Descubra a diferença!</span>
          </h1>
        </div>
        
      </div>
      
      <!-- LADO DIREITO: Cards de Features 2x2 -->
      <div class="right-features-area">
        <div class="features-grid-2x2">
          
          <!-- Card 1 - Cloud Download -->
          <div class="feature-box">
            <div class="feature-icon-circle">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M38 28C40.2091 28 42 26.2091 42 24C42 21.7909 40.2091 20 38 20C37.9224 20 37.8453 20.0026 37.769 20.0075C37.4266 16.2999 34.2999 13.5 30.5 13.5C28.2241 13.5 26.1743 14.5178 24.8486 16.1443C24.038 15.7071 23.1128 15.5 22.125 15.5C19.0344 15.5 16.5 18.0344 16.5 21.125C16.5 21.3525 16.5146 21.5766 16.5432 21.7964C14.3159 22.2395 12.625 24.1359 12.625 26.5C12.625 29.1234 14.7516 31.25 17.375 31.25H38Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M24 26V36M24 36L21 33M24 36L27 33" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <p class="feature-description">Baixe arquivos em segundos, assista a vídeos sem travamentos e aproveite uma navegação contínua, pensada para não interromper seu dia.</p>
          </div>
          
          <!-- Card 2 - Shield Check -->
          <div class="feature-box">
            <div class="feature-icon-circle">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M24 8L14 12V20C14 27.7 18.6 34.4 24 37C29.4 34.4 34 27.7 34 20V12L24 8Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M20 24L22.5 26.5L28 21" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <p class="feature-description">Nossa conexão é desenvolvida com foco em proteção digital, utilizando recursos avançados contra ameaças online para manter seus dados sempre protegidos.</p>
          </div>
          
          <!-- Card 3 - WiFi Signal -->
          <div class="feature-box">
            <div class="feature-icon-circle">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 19C16.3913 15.25 20.6957 13.5 24 13.5C27.3043 13.5 31.6087 15.25 36 19" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M16 24C18.6522 21.75 21.3261 20.5 24 20.5C26.6739 20.5 29.3478 21.75 32 24" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="24" cy="31" r="2.5" fill="white"/>
              </svg>
            </div>
            <p class="feature-description">Ideal para videochamadas, trabalho remoto e entretenimento, nossa internet entrega desempenho constante e confiança em cada acesso.</p>
          </div>
          
          <!-- Card 4 - Headset Support -->
          <div class="feature-box">
            <div class="feature-icon-circle">
              <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="12" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M18 20C18 20 19.5 17 24 17C28.5 17 30 20 30 20" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M18 26H16.5C15.6716 26 15 26.6716 15 27.5V29.5C15 30.3284 15.6716 31 16.5 31H18V26Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M30 26H31.5C32.3284 26 33 26.6716 33 27.5V29.5C33 30.3284 32.3284 31 31.5 31H30V26Z" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <p class="feature-description">Atendimento 24 horas por dia, com uma equipe preparada para resolver rapidamente e oferecer soluções sob medida, sem dor de cabeça.</p>
          </div>
          
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&family=Poppins:wght@300;400;500;600;700;800&display=swap');
  
  /* Reset para evitar margens brancas */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  /* Forçar largura total removendo margens de elementos pai */
  .connectivity-banner-original {
    margin-left: calc(-50vw + 50%) !important;
    margin-right: calc(-50vw + 50%) !important;
    width: 100vw !important;
    max-width: 100vw !important;
  }
  
  /* ==================== CONTAINER PRINCIPAL ==================== */
  .connectivity-banner-original {
    position: relative;
    width: 100vw;
    min-height: 771.47px;
    background: linear-gradient(135deg, #1fc9e0 0%, #00bcd4 50%, #00a8c5 100%);
    overflow: hidden;
    font-family: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
    left: 0;
    right: 0;
  }
  
  .banner-container-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: inherit;
  }
  
  /* ==================== BACKGROUND DE REDE ==================== */
  .network-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.7;
    pointer-events: none;
    z-index: 1;
  }
  
  .network-svg-bg {
    width: 100%;
    height: 100%;
  }
  
  /* ==================== CURVAS SUPERIOR DIREITA ==================== */
  .top-right-curves {
    position: absolute;
    top: 0;
    right: 0;
    width: 600px;
    height: 280px;
    pointer-events: none;
    z-index: 2;
    overflow: hidden;
  }
  
  .top-right-curves svg {
    width: 100%;
    height: 100%;
  }
  
  /* ==================== ONDAS INFERIOR ==================== */
  .bottom-waves {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 150px;
    pointer-events: none;
    z-index: 2;
  }
  
  .bottom-waves svg {
    width: 100%;
    height: 100%;
  }
  
  /* ==================== TIRAS DECORATIVAS LATERAIS ==================== */
  .side-strip {
    position: absolute;
    top: 0;
    height: 100%;
    width: 150px;
    pointer-events: none;
    z-index: 3;
    opacity: 0.25;
  }
  
  .left-strip {
    left: 0;
  }
  
  .right-strip {
    right: 0;
    transform: scaleX(-1);
  }
  
  .strip-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  
  /* ==================== GRID DE CONTEÚDO ==================== */
  .content-main-grid {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 80px 0;
    gap: 0;
    min-height: 771.47px;
  }
  
  /* ==================== ÁREA ESQUERDA ==================== */
  .left-content-area {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 50px;
    padding: 0 80px 0 100px;
    height: 100%;
  }
  
  /* Container Cadu com Foguete */
  .cadu-rocket-wrapper {
    flex-shrink: 0;
    width: 450px;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: float-rocket 3.5s ease-in-out infinite;
  }
  
  @keyframes float-rocket {
    0%, 100% {
      transform: translateY(0) rotate(-6deg);
    }
    50% {
      transform: translateY(-18px) rotate(-8deg);
    }
  }
  
  .cadu-mascot-image {
    width: 100%;
    height: auto;
    max-width: 420px;
    filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.15));
  }
  
  /* Bloco de Título */
  .title-main-block {
    flex: 1;
  }
  
  .main-heading {
    margin: 0;
    padding: 0;
    line-height: 1.15;
  }
  
  .heading-line {
    display: block;
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 900;
    font-family: 'Montserrat', 'Poppins', sans-serif;
    color: #ffffff;
    letter-spacing: -0.01em;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
    text-transform: none;
    line-height: 1.2;
  }
  
  .heading-line-light {
    display: block;
    font-size: clamp(2.2rem, 4vw, 3rem);
    font-weight: 400;
    font-family: 'Montserrat', 'Poppins', sans-serif;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin-top: 10px;
    opacity: 0.97;
    text-shadow: 0 2px 15px rgba(0, 0, 0, 0.08);
    text-transform: none;
  }
  
  /* ==================== ÁREA DIREITA - FEATURES ==================== */
  .right-features-area {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 100px 0 80px;
    height: 100%;
  }
  
  .features-grid-2x2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
    max-width: 750px;
  }
  
  /* Cards de Feature */
  .feature-box {
    background: rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-radius: 22px;
    padding: 32px 28px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
  }
  
  .feature-box:hover {
    background: rgba(255, 255, 255, 0.23);
    transform: translateY(-6px);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.18);
    border-color: rgba(255, 255, 255, 0.4);
  }
  
  /* Ícone do Card */
  .feature-icon-circle {
    width: 64px;
    height: 64px;
    background: rgba(255, 255, 255, 0.24);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    transition: all 0.3s ease;
  }
  
  .feature-box:hover .feature-icon-circle {
    background: rgba(255, 255, 255, 0.32);
    transform: scale(1.08);
  }
  
  .feature-icon-circle svg {
    width: 38px;
    height: 38px;
  }
  
  /* Descrição do Card */
  .feature-description {
    margin: 0;
    font-size: 15.5px;
    line-height: 1.65;
    font-weight: 400;
    color: #ffffff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
  
  /* ==================== RESPONSIVIDADE ==================== */
  
  /* Tablets grandes e desktops pequenos */
  @media (max-width: 1300px) {
    .left-content-area {
      padding: 0 40px 0 60px;
    }
    
    .right-features-area {
      padding: 0 60px 0 40px;
    }
    
    .cadu-rocket-wrapper {
      width: 300px;
      height: 340px;
    }
    
    .cadu-mascot-image {
      max-width: 280px;
    }
  }
  
  /* Tablets */
  @media (max-width: 1100px) {
    .connectivity-banner-original {
      min-height: auto;
      height: auto;
    }
    
    .content-main-grid {
      grid-template-columns: 1fr;
      padding: 45px 0;
      gap: 40px;
      min-height: auto;
      height: auto;
    }
    
    .left-content-area {
      flex-direction: column;
      text-align: center;
      padding: 0 40px;
      gap: 35px;
    }
    
    .title-main-block {
      width: 100%;
    }
    
    .heading-line,
    .heading-line-light {
      text-align: center;
    }
    
    .right-features-area {
      padding: 0 40px;
      width: 100%;
    }
    
    .features-grid-2x2 {
      max-width: 680px;
      margin: 0 auto;
    }
    
    .cadu-rocket-wrapper {
      width: 280px;
      height: 320px;
    }
    
    .cadu-mascot-image {
      max-width: 260px;
    }
  }
  
  /* Tablets pequenos */
  @media (max-width: 768px) {
    .content-main-grid {
      padding: 40px 0;
    }
    
    .left-content-area {
      padding: 0 30px;
    }
    
    .right-features-area {
      padding: 0 30px;
    }
    
    .heading-line {
      font-size: 2.2rem;
    }
    
    .heading-line-light {
      font-size: 2rem;
    }
    
    .features-grid-2x2 {
      gap: 16px;
    }
    
    .feature-box {
      padding: 24px 20px;
    }
    
    .feature-description {
      font-size: 13px;
      line-height: 1.55;
    }
    
    .cadu-rocket-wrapper {
      width: 250px;
      height: 290px;
    }
    
    .cadu-mascot-image {
      max-width: 230px;
    }
    
    .top-right-curves {
      width: 400px;
      height: 180px;
    }
    
    .side-strip {
      width: 80px;
      opacity: 0.2;
    }
  }
  
  /* Mobile */
  @media (max-width: 640px) {
    .content-main-grid {
      padding: 35px 0;
      gap: 40px;
    }
    
    .left-content-area {
      padding: 0 25px;
    }
    
    .right-features-area {
      padding: 0 25px;
    }
    
    .features-grid-2x2 {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin: 0 auto;
    }
    
    .heading-line {
      font-size: 1.9rem;
    }
    
    .heading-line-light {
      font-size: 1.7rem;
    }
    
    .cadu-rocket-wrapper {
      width: 230px;
      height: 270px;
    }
    
    .cadu-mascot-image {
      max-width: 210px;
    }
    
    .side-strip {
      width: 60px;
      opacity: 0.15;
    }
  }
  
  /* Mobile pequeno */
  @media (max-width: 480px) {
    .content-main-grid {
      padding: 30px 0;
    }
    
    .left-content-area {
      padding: 0 20px;
    }
    
    .right-features-area {
      padding: 0 20px;
    }
    
    .feature-box {
      padding: 22px 18px;
    }
    
    .feature-icon-circle {
      width: 50px;
      height: 50px;
      margin-bottom: 14px;
    }
    
    .feature-icon-circle svg {
      width: 30px;
      height: 30px;
    }
    
    .feature-description {
      font-size: 12.5px;
      line-height: 1.5;
    }
    
    .heading-line {
      font-size: 1.7rem;
    }
    
    .heading-line-light {
      font-size: 1.5rem;
    }
    
    .top-right-curves {
      width: 320px;
      height: 150px;
    }
    
    .bottom-waves {
      height: 90px;
    }
    
    .side-strip {
      width: 50px;
      opacity: 0.1;
    }
  }
</style>